{
  "name": "cnn-legal-static-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && npm run test && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "embeddings:build": "node --env-file-if-exists=.env.local --import ./scripts/register.mjs scripts/build-embedding-index.ts",
    "test": "node --import ./tests/register.mjs --test \"tests/**/*.test.ts\""
  },
  "overrides": {
    "path-to-regexp": "6.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/vercel": "^11.0.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "astro": "7.4.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@fontsource-variable/raleway": "^5.3.0"
  }
}
