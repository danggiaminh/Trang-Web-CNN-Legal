---
import { Image, getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AskBox from "../../components/AskBox.astro";
import { getAllArticles, type Article } from "../../data/articles";
import { site } from "../../data/site";
import { blurPlaceholder } from "../../lib/blur-placeholder";

export async function getStaticPaths() {
  const articles = await getAllArticles();
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const title = `${article.title} | ${site.name}`;
const description = article.excerpt;
const canonicalPath = `/bai-viet/${article.slug}/`;
const pageUrl = new URL(canonicalPath, site.canonicalBaseUrl).toString();
const dateIso = article.publishedAt !== "Đang cập nhật"
  ? article.publishedAt.split("/").reverse().join("-")
  : undefined;

const firstImageIndex = article.blocks.findIndex((b) => b.type === "image");

// Ảnh "/images/…" dùng bản trong src/assets để Astro dựng được các cỡ; bản trong public/ giữ cho link cũ.
const localImages = import.meta.glob<{ default: ImageMetadata }>("../../assets/images/article-*", { eager: true });
const localImage = article.imageUrl.startsWith("/")
  ? localImages[`../../assets${article.imageUrl}`]?.default
  : undefined;
if (article.imageUrl.startsWith("/") && !localImage) {
  throw new Error(`Bài ${article.slug}: thiếu ảnh src/assets${article.imageUrl}`);
}
// Ảnh lsvn.vn: cỡ thật ghi trong dữ liệu, hỏi cỡ lúc build thì mỗi lần build lại phải gọi máy chủ lsvn.
if (!localImage && !(article.imageWidth && article.imageHeight)) {
  throw new Error(`Bài ${article.slug}: thiếu imageWidth/imageHeight (cỡ thật của ảnh ${article.imageUrl})`);
}
// <Image> nhận ảnh import hoặc URL kèm cỡ, không nhận biến mang kiểu chung của cả hai nên tách hai dạng.
const imageSource = localImage
  ? { src: localImage }
  : { src: article.imageUrl, width: article.imageWidth, height: article.imageHeight };
// Ảnh chia sẻ (Facebook, Zalo): JPEG đúng cỡ gốc, tải từ cnnlegal.vn thay vì máy chủ lsvn chậm.
const ogImage = await getImage({ ...imageSource, format: "jpg", quality: 80 });
const ogImageUrl = new URL(ogImage.src, site.canonicalBaseUrl).toString();
// Cỡ gốc lấy qua getImage: đọc thẳng width của ảnh import thì Astro coi ảnh gốc là có dùng, chép thêm vào bản build.
const imageWidth: number = ogImage.attributes.width;
const imageHeight: number = ogImage.attributes.height;
// Không xin cỡ lớn hơn ảnh gốc: Astro không phóng to, chỉ trả lại đúng ảnh gốc dưới tên khác.
const imageWidths = [...[320, 640, 768].filter((w) => w < imageWidth), imageWidth];
// Ảnh lấy từ lsvn.vn không làm ảnh xem trước: máy chủ ảnh lsvn trả mỗi ảnh mất 4–60 s (đo
// 18/10/2026), tải thêm lúc build thì build chậm hẳn hoặc hỏng. Ảnh trong src/assets thì làm được.
const imageBlur = localImage ? await blurPlaceholder(localImage) : undefined;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: article.title,
    description: article.excerpt,
    image: ogImageUrl,
    ...(dateIso ? { datePublished: dateIso } : {}),
    author: {
      "@type": "Person",
      name: "Đặng Kim Chinh",
      url: site.externalProfileUrl,
    },
    isBasedOn: article.sourceUrl,
    publisher: {
      "@type": "Organization",
      name: site.name,
      url: site.canonicalBaseUrl,
    },
    copyrightHolder: {
      "@type": "Organization",
      name: article.sourceName,
      url: new URL(article.sourceUrl).origin,
    },
    inLanguage: "vi-VN",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Trang chủ", item: site.canonicalBaseUrl },
      { "@type": "ListItem", position: 2, name: "Bài viết", item: new URL("/bai-viet/", site.canonicalBaseUrl).toString() },
      { "@type": "ListItem", position: 3, name: article.title, item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  ogType="article"
  ogImage={ogImage.src}
  ogImageWidth={imageWidth}
  ogImageHeight={imageHeight}
  ogImageAlt={article.imageAlt || article.title}
  structuredData={structuredData}
>
  <article class="bg-warm-ivory">

    <div class="border-b border-border-soft bg-surface-white">
      <div class="section-shell py-10 md:py-12">
        <div class="inline-flex items-center gap-2">
          <span class="text-[0.75rem] font-semibold text-text-dark">
            {article.category}
          </span>
          <span class="text-[0.75rem] font-medium text-text-muted">{article.publishedAt}</span>
        </div>

        <h1 class="mt-4 text-balance max-w-3xl text-[1.625rem] font-semibold leading-[1.3] text-text-dark md:text-[2rem]">
          {article.title}
        </h1>

        <p class="mt-3 text-[0.875rem] font-medium text-text-muted">
          Nguồn: <span class="text-text-dark">{article.sourceName}</span>
        </p>
      </div>
    </div>

    <div class="section-shell py-10 md:py-14">
      <div class="mx-auto max-w-3xl">

        <div class="article-body mt-8 space-y-5">
          {article.blocks.map((block, i) => {
            switch (block.type) {
              case "lead":
                return (
                  <p class="text-[1.0625rem] font-bold leading-[1.7] text-text-dark">
                    {block.text}
                  </p>
                );
              case "heading":
                return (
                  <h2 class="pt-3 text-[1.0625rem] font-bold leading-snug text-text-dark">
                    {block.text}
                  </h2>
                );
              case "subheading":
                return (
                  <h3 class="pt-2 text-[0.9375rem] font-bold italic leading-snug text-text-dark">
                    {block.text}
                  </h3>
                );
              case "italic":
                return (
                  <p class="pt-1 text-[0.9375rem] italic leading-[1.8] text-text-dark">
                    {block.text}
                  </p>
                );
              case "paragraph":
                return (
                  <p class="text-[0.9375rem] leading-[1.8] text-text-dark">
                    {block.text}
                  </p>
                );
              case "quote":
                return (
                  <p class="border-l-2 border-border-soft pl-4 text-[0.9375rem] leading-[1.8] text-text-dark">
                    {block.text}
                  </p>
                );
              case "image":
                return (
                  <figure class="pt-1">
                    <div class="overflow-hidden rounded-sm border border-border-soft bg-muted-blue">
                      {/* Đúng tỉ lệ ảnh gốc, không cắt. Khung rộng 48rem; trên 1366px rem phóng theo
                          màn hình nên 48rem = 56.22vw. */}
                      <Image
                        {...imageSource}
                        class="w-full"
                        alt={article.imageAlt}
                        width={imageWidth}
                        height={imageHeight}
                        widths={imageWidths}
                        sizes="(min-width: 1367px) 56.22vw, (min-width: 768px) 768px, 100vw"
                        quality={80}
                        loading={i === firstImageIndex ? "eager" : "lazy"}
                        fetchpriority={i === firstImageIndex ? "high" : undefined}
                        style={imageBlur && `background:${imageBlur} center/cover`}
                      />
                    </div>
                    {block.caption && (
                      <figcaption class="mt-2 text-center text-[0.8125rem] italic text-text-muted">
                        {block.caption}
                      </figcaption>
                    )}
                  </figure>
                );
              case "noteHeading":
                return (
                  <p class="pt-2 text-[0.8125rem] font-bold leading-[1.75] text-text-dark">
                    {block.text}
                  </p>
                );
              case "note":
                return (
                  <p class="text-[0.8125rem] leading-[1.75] text-text-dark">
                    {block.text}
                  </p>
                );
              case "signature":
                return (
                  <div class="pt-4">
                    <p class:list={["text-[0.9375rem] leading-[1.8] text-text-dark", block.nameBold && "font-bold"]}>
                      {block.name}
                    </p>
                    <p class:list={["text-[0.9375rem] leading-[1.8] text-text-dark", block.orgItalic && "italic"]}>
                      {block.org}
                    </p>
                  </div>
                );
            }
          })}
        </div>

        <div class="mt-10 border-t border-border-soft pt-6">
          <p class="text-[0.8125rem] font-semibold text-text-muted">
            Nguồn: {article.sourceName}
          </p>
          <a
            class="mt-2 inline-flex items-center gap-1.5 text-[0.8125rem] font-medium text-deep-blue-navy hover:text-professional-blue"
            href={article.sourceUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            {article.originalLinkLabel}
            <svg class="h-3.5 w-3.5" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2 7h10M7 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

        <div class="mt-6">
          <a class="secondary-button" href="/bai-viet/">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12l14 0" />
              <path d="M5 12l4 4" />
              <path d="M5 12l4 -4" />
            </svg>
            Tất cả bài viết
          </a>
        </div>

        <div class="h-24" aria-hidden="true"></div>
      </div>
    </div>
  </article>

  <AskBox />
</BaseLayout>
