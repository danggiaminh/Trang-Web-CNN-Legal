---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroBreadcrumb from "../../components/HeroBreadcrumb.astro";
import { site } from "../../data/site";
import aboutHero from "../../assets/images/about-hero.jpg";

const title = `Tổng quan | ${site.name}`;
const description =
  "Tổng quan về CNN Legal – công ty luật chuyên về tư vấn pháp lý, bào chữa hình sự và hỗ trợ doanh nghiệp tại Thành phố Hồ Chí Minh.";
const canonicalPath = "/tong-quan/";
const pageUrl = new URL(canonicalPath, site.canonicalBaseUrl).toString();
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    name: title,
    description,
    url: pageUrl,
    inLanguage: "vi-VN",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Trang chủ", item: site.canonicalBaseUrl },
      { "@type": "ListItem", position: 2, name: "Tổng quan", item: pageUrl },
    ],
  },
];
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} structuredData={structuredData}>

  <section class="relative overflow-hidden py-24 md:py-32 lg:py-40">

    <div class="absolute inset-0 z-0 bg-ink-black">
      <Image
        class="h-full w-full object-cover object-center"
        src={aboutHero}
        alt="Hình ảnh giới thiệu CNN Legal"
        widths={[320, 640, 768, 1024, 1280, 1536, 1920]}
        sizes="100vw"
        quality={80}
        loading="eager"
        fetchpriority="high"
      />

      <div class="absolute inset-0 bg-black/50"></div>
    </div>


    <div class="section-shell relative z-10">
      <HeroBreadcrumb items={[{ label: "Trang chủ", href: "/" }, { label: "Tổng quan" }]} />

      <h1 class="mt-8 max-w-3xl font-sans text-[2.25rem] font-semibold leading-[1.14] tracking-[-0.01em] text-white md:text-[2.75rem] lg:text-[3.125rem]">
        Về chúng tôi
      </h1>

      <p class="mt-6 max-w-xl font-sans text-[1rem] leading-[1.8] text-white/80 md:text-[1.0625rem]">
        CNN Legal là công ty luật tại TP. Hồ Chí Minh. Chúng tôi không hứa hẹn những điều không chắc chắn — chỉ làm việc thật sự, nói thẳng những gì bạn cần biết, và đứng về phía bạn đến cùng.
      </p>
    </div>
  </section>


  <section class="bg-panel-cream">
    <div class="section-shell py-16 md:py-24">
      <div class="grid gap-10 md:grid-cols-[200px_1fr] lg:grid-cols-[240px_1fr]">


        <div class="pt-1">
          <p class="font-sans text-[1.0625rem] font-medium text-text-dark">Tổng quan</p>
          <div class="mt-3 h-px w-8 bg-text-dark"></div>
        </div>


        <div class="font-sans text-[1rem] leading-[1.85] text-text-dark space-y-5">
          <p>
            CNN Legal là công ty luật tại TP. Hồ Chí Minh, hỗ trợ khách hàng cá nhân và doanh nghiệp trong các lĩnh vực tranh tụng hình sự, dân sự, đất đai, hợp đồng và tư vấn pháp lý thương mại.
          </p>
          <p>
            Đội ngũ của chúng tôi có kinh nghiệm thực chiến trong nhiều loại vụ việc khác nhau, từ tranh chấp dân sự đến các vụ án hình sự kinh tế phức tạp. Chúng tôi tiếp cận mỗi vụ việc bằng sự chuẩn bị kỹ lưỡng và thái độ làm việc thẳng thắn — nói rõ những gì có thể làm được, và cả những gì không.
          </p>
          <p>
            Chúng tôi hiểu rằng khi khách hàng tìm đến luật sư, họ thường đang đối mặt với những vấn đề không nhỏ. Điều chúng tôi có thể làm là lắng nghe, phân tích tình huống một cách thực tế, tư vấn trung thực về các lựa chọn, và đồng hành trong suốt quá trình giải quyết vụ việc.
          </p>
          <p>
            CNN Legal hoạt động trên nền tảng của sự chính trực và trách nhiệm nghề nghiệp — làm đúng việc, đúng cách, vì quyền lợi thực sự của khách hàng.
          </p>
        </div>

      </div>
    </div>
  </section>


  <section class="bg-panel-taupe border-t border-panel-taupe-border">
    <div class="section-shell py-16 md:py-24">
      <div class="grid gap-10 md:grid-cols-[200px_1fr] lg:grid-cols-[240px_1fr]">


        <div class="pt-1">
          <p class="font-sans text-[1.0625rem] font-medium text-text-dark">Đóng góp cho cộng đồng</p>
          <div class="mt-3 h-px w-8 bg-text-dark"></div>
        </div>


        <div class="font-sans text-[1rem] leading-[1.85] text-text-dark">
          <p>
            Chúng tôi tin rằng nghề luật không chỉ là giải quyết tranh chấp — mà còn là góp phần xây dựng một xã hội công bằng hơn. CNN Legal cam kết dành thời gian và năng lực để hỗ trợ những cá nhân, gia đình và doanh nghiệp nhỏ đang đối mặt với các vấn đề pháp lý mà không có nhiều nguồn lực. Với chúng tôi, trách nhiệm với cộng đồng không phải là khẩu hiệu — mà là một phần trong cách chúng tôi hành nghề mỗi ngày.
          </p>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
