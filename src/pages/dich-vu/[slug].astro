---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceShell from "../../components/ServiceShell.astro";
import { services } from "../../data/services";
import { notableCases } from "../../data/cases";
import { site } from "../../data/site";

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;

// Slug gõ sai trong services.ts phải làm hỏng build, đừng để thành link chết.
const relatedCases = service.caseSlugs.map((slug) => {
  const found = notableCases.find((c) => c.slug === slug);
  if (!found) throw new Error(`services.ts: "${service.slug}" trỏ tới vụ án không tồn tại "${slug}"`);
  return found;
});

const path = `/dich-vu/${service.slug}/`;
const pageUrl = new URL(path, site.canonicalBaseUrl).toString();
const title = `${service.title} | ${site.name}`;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: service.title,
    serviceType: service.title,
    description: service.summary,
    url: pageUrl,
    provider: { "@id": `${site.canonicalBaseUrl}/#legal-service` },
    areaServed: { "@type": "City", name: site.areaServed },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Trang chủ", item: site.canonicalBaseUrl },
      {
        "@type": "ListItem",
        position: 2,
        name: "Dịch vụ",
        item: new URL("/dich-vu/", site.canonicalBaseUrl).toString(),
      },
      { "@type": "ListItem", position: 3, name: service.title, item: pageUrl },
    ],
  },
];
---

<BaseLayout title={title} description={service.summary} canonicalPath={path} structuredData={structuredData}>
  <ServiceShell
    crumbs={[{ label: "Trang chủ", href: "/" }, { label: "Dịch vụ", href: "/dich-vu/" }, { label: service.title }]}
    currentSlug={service.slug}
  >
    <h1>{service.title}</h1>
    <p>{service.description}</p>

    <h2 class="svc-label">Phạm vi dịch vụ</h2>
    <ul class="svc-plain-list">
      {service.situations.map((item) => <li>{item}</li>)}
    </ul>

    {relatedCases.length > 0 && (
      <>
        <h2 class="related-title">Vụ án liên quan</h2>
        <ul class="related-list">
          {relatedCases.map((c) => (
            <li>
              <a href={`/vu-an-tieu-bieu/${c.slug}/`}>{c.title}</a>
              <span>{[c.court, c.date].filter(Boolean).join(" · ")}</span>
            </li>
          ))}
        </ul>
      </>
    )}
  </ServiceShell>
</BaseLayout>

<style>
  .related-title {
    margin: 3.5rem 0 0.75rem;
    font-size: 1.625rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-text-dark);
  }

  .related-list {
    display: grid;
    gap: 1rem;
  }

  .related-list li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .related-list a {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
    /* Cùng màu link bài viết ở trang Bài viết */
    color: #1a4a9e;
    text-underline-offset: 2px;
    transition: color 150ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .related-list a:hover {
    color: #0f2f6b;
    text-decoration: underline;
  }

  .related-list span {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
</style>
