---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceShell from "../../components/ServiceShell.astro";
import { services } from "../../data/services";
import { site } from "../../data/site";

const title = `Dịch vụ pháp lý | ${site.name}`;
const description =
  "Các dịch vụ pháp lý của CNN Legal được trình bày theo từng lĩnh vực để khách hàng dễ xác định nhu cầu tư vấn ban đầu.";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: new URL("/dich-vu/", site.canonicalBaseUrl).toString(),
    inLanguage: "vi-VN",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Trang chủ",
        item: site.canonicalBaseUrl,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Dịch vụ",
        item: new URL("/dich-vu/", site.canonicalBaseUrl).toString(),
      },
    ],
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/dich-vu/" structuredData={structuredData}>
  <ServiceShell crumbs={[{ label: "Trang chủ", href: "/" }, { label: "Dịch vụ" }]} titleIsH1>
    <p>
      CNN Legal cung cấp các dịch vụ pháp lý trọng tâm gồm: Bào chữa hình sự; Tranh tụng dân sự, kinh doanh, thương mại &amp; hành chính; Đàm phán, giải quyết tranh chấp đất đai &amp; bất động sản; Tư vấn đầu tư, doanh nghiệp và hợp đồng.
    </p>

    <h2 class="svc-label">Dịch vụ hỗ trợ</h2>
    <ul class="svc-plain-list">
      {services.map((s) => (
        <li><a href={`/dich-vu/${s.slug}/`}>{s.title}</a></li>
      ))}
    </ul>
  </ServiceShell>
</BaseLayout>
