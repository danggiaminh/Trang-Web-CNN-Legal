---
import { Picture } from "astro:assets";
import HeroBreadcrumb from "../components/HeroBreadcrumb.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import lienHeHero from "../assets/images/contact-river.jpg";
import { blurPlaceholder } from "../lib/blur-placeholder";

const title = `Liên hệ | ${site.name}`;
const description =
  "Thông tin liên hệ trực tiếp của CNN Legal qua email và điện thoại.";
const pagePath = "/lien-he/";
const pageUrl = new URL(pagePath, site.canonicalBaseUrl).toString();
const heroBlur = await blurPlaceholder(lienHeHero);
const legalServiceData = {
  "@context": "https://schema.org",
  "@type": ["Organization", "LegalService"],
  "@id": `${site.canonicalBaseUrl}/#legal-service`,
  name: site.name,
  url: site.canonicalBaseUrl,
  description: site.description,
  sameAs: [site.externalProfileUrl, site.linkedInUrl],
  telephone: site.publicPhone,
  email: site.publicEmail,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.streetAddress,
    addressLocality: site.address.addressLocality,
    addressRegion: site.address.addressRegion,
    addressCountry: site.address.addressCountry,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: site.geo.latitude,
    longitude: site.geo.longitude,
  },
  openingHoursSpecification: site.workingHours.map((h) => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    opens: h.opens,
    closes: h.closes,
  })),
};
const structuredData = [
  legalServiceData,
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: title,
    description,
    url: pageUrl,
    inLanguage: "vi-VN",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Trang chủ", item: site.canonicalBaseUrl },
      { "@type": "ListItem", position: 2, name: "Liên hệ", item: pageUrl },
    ],
  },
];
---

<BaseLayout title={title} description={description} canonicalPath={pagePath} structuredData={structuredData}>

  <section class="relative overflow-hidden py-24 md:py-32 lg:py-40">
    <div class="absolute inset-0 z-0" style={`background:#4a8b86 ${heroBlur} center/cover`}>
      {/* Ảnh 3:2; banner màn hẹp cao 286px (327px dưới 380px vì tiêu đề xuống dòng) nên
          ảnh phóng theo chiều cao, rộng ≈ 429px (≈ 491px). quality 65 như các banner khác
          (≈ WebP 80). Đoạn mô tả để dưới banner cho banner điện thoại thấp, ảnh nhẹ. */}
      <Picture
        class="h-full w-full object-cover object-center"
        src={lienHeHero}
        alt="Dòng sông giữa hai dãy núi"
        formats={["avif"]}
        fallbackFormat="webp"
        widths={[640, 768, 960, 1280, 1600, 1920, 2560, 3840]}
        sizes="(max-width: 379px) 491px, (max-width: 428px) 429px, 100vw"
        quality={65}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="section-shell relative z-10">
      <HeroBreadcrumb items={[{ label: "Trang chủ", href: "/" }, { label: "Liên hệ" }]} />
      <h1 class="mt-8 text-balance max-w-4xl font-sans text-[2.25rem] font-semibold leading-[1.14] tracking-[-0.01em] text-white md:text-[2.75rem] lg:text-[3.125rem]">
        Liên hệ với chúng tôi
      </h1>
    </div>
  </section>

  <section>
    <div class="section-shell pb-16 pt-8 md:pb-24 md:pt-10">
      <p class="prose-justify max-w-3xl font-sans text-[1rem] leading-[1.8] text-text-dark md:text-[1.0625rem]">
        Thông tin Quý khách cung cấp qua website chỉ bao gồm những nội dung cần thiết ban đầu. Khi tiếp nhận vụ việc, CNN Legal sẽ thống nhất phương thức trao đổi hồ sơ, tài liệu hoặc chứng cứ phù hợp nhằm bảo đảm tính bảo mật và an toàn của thông tin.
      </p>

      <div class="mt-10 max-w-3xl">

        <div class="space-y-8 font-sans text-[1rem] leading-[1.85] text-text-dark">
          <div>
            <p class="text-[1.0625rem] font-medium text-text-dark">Văn phòng</p>
            <div class="mt-3 h-px w-8 bg-text-dark"></div>
          </div>

          <div>
            <p class="font-semibold">Email</p>
            <a class="mt-1 block text-[1rem] leading-[1.85] text-text-dark hover:text-deep-blue-navy" href={`${site.publicEmailHref}?subject=${encodeURIComponent('Yêu cầu tư vấn pháp lý – CNN Legal')}`}>
              {site.publicEmail}
            </a>
          </div>

          <div>
            <p class="font-semibold">Số điện thoại</p>
            <a class="mt-1 block text-[1rem] leading-[1.85] text-text-dark hover:text-deep-blue-navy" href={site.publicPhoneHref}>
              {site.publicPhone}
            </a>
          </div>

          <div>
            <p class="font-semibold">Địa chỉ</p>
            <p class="mt-1 text-[1rem] leading-[1.85] text-text-dark">{site.addressDisplay}</p>
          </div>

          <div>
            <p class="font-semibold">Thời gian làm việc</p>
            {site.workingHoursLines.map((line) => (
              <p class="mt-1 text-[1rem] leading-[1.85] text-text-dark">{line}</p>
            ))}
          </div>

          <div class="mt-8 max-w-md overflow-hidden rounded-xl border border-input-border">
            <iframe
              data-map-src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.2979383976517!2d106.76532397666304!3d10.788477589361069!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x317527003ee47bdf%3A0x75dc07e36f22f8e1!2zQ8O0bmcgdHkgTHXhuq10IENOTiBMZWdhbA!5e0!3m2!1svi!2s!4v1784172388898!5m2!1svi!2s"
              width="100%"
              height="280"
              style="border:0; display:block;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              title="Vị trí văn phòng CNN Legal trên Google Maps"
            ></iframe>
          </div>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const mapFrame = document.querySelector<HTMLIFrameElement>('iframe[data-map-src]');
  if (mapFrame) {
    const loadMap = () => {
      if (!mapFrame.src) mapFrame.src = mapFrame.dataset.mapSrc!;
    };
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            loadMap();
            observer.disconnect();
          }
        },
        // Khởi động sớm 200px. Bản đồ nằm dưới mép màn 340px (Lighthouse mobile)
        // và 348px (Lighthouse desktop) nên ngưỡng này không bao giờ tự nổ khi
        // trang chỉ được tải mà không cuộn.
        { rootMargin: '200px 0px' }
      );
      observer.observe(mapFrame);
    } else {
      loadMap();
    }
  }
</script>
