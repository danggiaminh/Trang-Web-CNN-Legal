---
import { Image, Picture } from "astro:assets";
import HeroBreadcrumb from "../components/HeroBreadcrumb.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import lienHeHero from "../assets/images/contact-river.jpg";
import contactSuccessBg from "../assets/images/contact-success-bg.avif";
import { blurPlaceholder } from "../lib/blur-placeholder";

const title = `Liên hệ | ${site.name}`;
const description =
  "Thông tin liên hệ trực tiếp của CNN Legal qua email và điện thoại.";
const pagePath = "/lien-he/";
const pageUrl = new URL(pagePath, site.canonicalBaseUrl).toString();
const heroBlur = await blurPlaceholder(lienHeHero);
// Cờ build: đặt cả PUBLIC_CONTACT_API_URL và PUBLIC_TURNSTILE_SITE_KEY thì form gửi vào Contact API
// (Cloudflare Worker + D1, xem workers/contact-api) thay cho /api/v1/contact. Không đặt thì trang giữ nguyên.
const contactApiUrl = import.meta.env.PUBLIC_CONTACT_API_URL;
if (Boolean(contactApiUrl) !== Boolean(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY)) {
  throw new Error("Cần đặt cùng lúc PUBLIC_CONTACT_API_URL và PUBLIC_TURNSTILE_SITE_KEY.");
}
if (contactApiUrl && !/^(https:\/\/|http:\/\/(localhost|127\.0\.0\.1)[:/])/.test(contactApiUrl)) {
  throw new Error("PUBLIC_CONTACT_API_URL phải là địa chỉ https://.");
}
// Phải trùng CONSENT_VERSION của Worker: sửa câu đồng ý dưới form thì đổi cả hai. Câu chữ là bản nháp, chờ rà soát pháp lý.
// Các khối {consentVersion && …} viết dính liền thẻ đứng trước: compressHTML mới không để dư khoảng trắng khi tắt cờ.
const consentVersion = contactApiUrl ? "2026-10-30-draft" : null;
const legalServiceData = {
  "@context": "https://schema.org",
  "@type": ["Organization", "LegalService"],
  "@id": `${site.canonicalBaseUrl}/#legal-service`,
  name: site.name,
  url: site.canonicalBaseUrl,
  description: site.description,
  sameAs: [site.externalProfileUrl, site.linkedInUrl],
  telephone: site.publicPhone,
  email: site.publicEmail,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.streetAddress,
    addressLocality: site.address.addressLocality,
    addressRegion: site.address.addressRegion,
    addressCountry: site.address.addressCountry,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: site.geo.latitude,
    longitude: site.geo.longitude,
  },
  openingHoursSpecification: site.workingHours.map((h) => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    opens: h.opens,
    closes: h.closes,
  })),
};
const structuredData = [
  legalServiceData,
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: title,
    description,
    url: pageUrl,
    inLanguage: "vi-VN",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Trang chủ", item: site.canonicalBaseUrl },
      { "@type": "ListItem", position: 2, name: "Liên hệ", item: pageUrl },
    ],
  },
];
---

<BaseLayout title={title} description={description} canonicalPath={pagePath} structuredData={structuredData}>

  <section class="relative overflow-hidden py-24 md:py-32 lg:py-40">
    <div class="absolute inset-0 z-0" style={`background:#4a8b86 ${heroBlur} center/cover`}>
      {/* Ảnh 3:2; banner màn hẹp cao 286px (327px dưới 380px vì tiêu đề xuống dòng) nên
          ảnh phóng theo chiều cao, rộng ≈ 429px (≈ 491px). quality 65 như các banner khác
          (≈ WebP 80). Đoạn mô tả để dưới banner cho banner điện thoại thấp, ảnh nhẹ. */}
      <Picture
        class="h-full w-full object-cover object-center"
        src={lienHeHero}
        alt="Dòng sông giữa hai dãy núi"
        formats={["avif"]}
        fallbackFormat="webp"
        widths={[640, 768, 960, 1280, 1600, 1920, 2560, 3840]}
        sizes="(max-width: 379px) 491px, (max-width: 428px) 429px, 100vw"
        quality={65}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="section-shell relative z-10">
      <HeroBreadcrumb items={[{ label: "Trang chủ", href: "/" }, { label: "Liên hệ" }]} />
      <h1 class="mt-8 text-balance max-w-4xl font-sans text-[2.25rem] font-semibold leading-[1.14] tracking-[-0.01em] text-white md:text-[2.75rem] lg:text-[3.125rem]">
        Liên hệ với chúng tôi
      </h1>
    </div>
  </section>

  <section class="bg-panel-cream">
    <div class="section-shell py-16 md:py-24">
      <p class="prose-justify max-w-3xl font-sans text-[1rem] leading-[1.8] text-text-dark md:text-[1.0625rem]">
        Thông tin Quý khách cung cấp qua website chỉ bao gồm những nội dung cần thiết ban đầu. Khi tiếp nhận vụ việc, CNN Legal sẽ thống nhất phương thức trao đổi hồ sơ, tài liệu hoặc chứng cứ phù hợp nhằm bảo đảm tính bảo mật và an toàn của thông tin.
      </p>

      <div class="mt-10 grid gap-16 lg:grid-cols-[1fr_1.2fr] lg:gap-20">

        <div class="space-y-8 font-sans text-[1rem] leading-[1.85] text-text-dark">
          <div>
            <p class="text-[1.0625rem] font-medium text-text-dark">Văn phòng</p>
            <div class="mt-3 h-px w-8 bg-text-dark"></div>
          </div>

          <div>
            <p class="font-semibold">Email</p>
            <a class="mt-1 block text-[1rem] leading-[1.85] text-text-dark hover:text-deep-blue-navy" href={`${site.publicEmailHref}?subject=${encodeURIComponent('Yêu cầu tư vấn pháp lý – CNN Legal')}`}>
              {site.publicEmail}
            </a>
          </div>

          <div>
            <p class="font-semibold">Số điện thoại</p>
            <a class="mt-1 block text-[1rem] leading-[1.85] text-text-dark hover:text-deep-blue-navy" href={site.publicPhoneHref}>
              {site.publicPhone}
            </a>
          </div>

          <div>
            <p class="font-semibold">Địa chỉ</p>
            <p class="mt-1 text-[1rem] leading-[1.85] text-text-dark">{site.addressDisplay}</p>
          </div>

          <div>
            <p class="font-semibold">Thời gian làm việc</p>
            {site.workingHoursLines.map((line) => (
              <p class="mt-1 text-[1rem] leading-[1.85] text-text-dark">{line}</p>
            ))}
          </div>

          <div class="mt-8 overflow-hidden rounded-xl border border-input-border">
            <iframe
              data-map-src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.2979383976517!2d106.76532397666304!3d10.788477589361069!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x317527003ee47bdf%3A0x75dc07e36f22f8e1!2zQ8O0bmcgdHkgTHXhuq10IENOTiBMZWdhbA!5e0!3m2!1svi!2s!4v1784172388898!5m2!1svi!2s"
              width="100%"
              height="280"
              style="border:0; display:block;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              title="Vị trí văn phòng CNN Legal trên Google Maps"
            ></iframe>
          </div>
        </div>

        <div>
          <form id="contact-form" method="post" novalidate data-email={site.publicEmail}>

          <div id="cf-fields">
            <p class="text-[1.0625rem] font-medium text-text-dark">Gửi liên hệ đến CNN Legal</p>
            <div class="mt-3 h-px w-8 bg-text-dark"></div>
            <noscript>
              <p class="mt-8 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-[0.875rem] text-red-800">Trình duyệt đang tắt JavaScript nên biểu mẫu chưa gửi được. Bạn gọi <a class="font-semibold" href={site.publicPhoneHref}>{site.publicPhone}</a> hoặc gửi email tới <a class="font-semibold" href={site.publicEmailHref}>{site.publicEmail}</a> giúp mình nhé.</p>
            </noscript>

            <div class="mt-8 space-y-5">
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="cf-name" class="block text-[0.875rem] font-normal text-text-dark">
                  Họ tên <span class="text-red-500" aria-hidden="true">*</span>
                </label>
                <input
                  id="cf-name"
                  name="name"
                  type="text"
                  required
                  maxlength="120"
                  autocomplete="name"
                  class="mt-2 w-full rounded-xl border border-input-border bg-white px-4 py-3 text-[0.9375rem] text-text-dark placeholder:text-text-muted focus:border-text-dark focus:outline-none"
                  placeholder="Họ tên của bạn"
                />
              </div>
              <div>
                <label for="cf-phone" class="block text-[0.875rem] font-normal text-text-dark">
                  Số điện thoại <span class="text-red-500" aria-hidden="true">*</span>
                </label>
                <input
                  id="cf-phone"
                  name="phone"
                  type="tel"
                  required
                  maxlength="32"
                  autocomplete="tel"
                  class="mt-2 w-full rounded-xl border border-input-border bg-white px-4 py-3 text-[0.9375rem] text-text-dark placeholder:text-text-muted focus:border-text-dark focus:outline-none"
                  placeholder="Số điện thoại để luật sư liên hệ"
                />
              </div>
            </div>

            <div>
              <label for="cf-email" class="block text-[0.875rem] font-normal text-text-dark">
                Email
              </label>
              <input
                id="cf-email"
                name="email"
                type="email"
                maxlength="200"
                autocomplete="email"
                class="mt-2 w-full rounded-xl border border-input-border bg-white px-4 py-3 text-[0.9375rem] text-text-dark placeholder:text-text-muted focus:border-text-dark focus:outline-none"
                placeholder="Email nhận phản hồi"
              />
            </div>

            <div>
              <label for="cf-field" class="block text-[0.875rem] font-normal text-text-dark">
                Lĩnh vực <span class="text-red-500" aria-hidden="true">*</span>
              </label>
              <select
                id="cf-field"
                name="field"
                required
                class="select-arrow mt-2 w-full rounded-xl border border-input-border bg-white py-3 pl-4 pr-11 text-[0.9375rem] text-text-dark focus:border-text-dark focus:outline-none"
              >
                <option value="" disabled selected style="color: #9ca3af;">— Chọn lĩnh vực —</option>
                <option value="Hình sự">Hình sự</option>
                <option value="Dân sự - Kinh doanh">Dân sự - Kinh doanh</option>
                <option value="Hành chính">Hành chính</option>
                <option value="Nghiên cứu và phản biện">Nghiên cứu và phản biện</option>
                <option value="Ứng tuyển vào CNN Legal">Ứng tuyển vào CNN Legal</option>
              </select>
            </div>

            <div>
              <label for="cf-subject" class="block text-[0.875rem] font-normal text-text-dark">
                Tiêu đề
              </label>
              <input
                id="cf-subject"
                name="subject"
                type="text"
                maxlength="200"
                class="mt-2 w-full rounded-xl border border-input-border bg-white px-4 py-3 text-[0.9375rem] text-text-dark placeholder:text-text-muted focus:border-text-dark focus:outline-none"
                placeholder="Mô tả ngắn gọn vụ việc..."
              />
            </div>

            <div>
              <label for="cf-message" class="block text-[0.875rem] font-normal text-text-dark">
                Nội dung <span class="text-red-500" aria-hidden="true">*</span>
              </label>
              <textarea
                id="cf-message"
                name="message"
                required
                maxlength="5000"
                rows="5"
                class="mt-2 w-full rounded-xl resize-none border border-input-border bg-white px-4 py-3 text-[0.9375rem] text-text-dark placeholder:text-text-muted focus:border-text-dark focus:outline-none"
                placeholder="Mô tả chi tiết vụ việc hoặc câu hỏi của bạn..."
              ></textarea>
            </div>{consentVersion && (
              <div>
                <label class="flex items-start gap-3 text-[0.875rem] leading-relaxed text-text-dark cursor-pointer">
                  <input id="cf-consent" name="consent" type="checkbox" required value={consentVersion} class="mt-1 h-4 w-4 shrink-0 cursor-pointer" style="accent-color: var(--color-ink-black)" />
                  <span>Tôi đồng ý để CNN Legal xử lý thông tin trên, kể cả nội dung vụ việc, nhằm liên hệ và tư vấn cho yêu cầu này. <span class="text-red-500" aria-hidden="true">*</span></span>
                </label>
                <div id="cf-turnstile"></div>
              </div>
            )}

            <div class="absolute h-px w-px overflow-hidden" aria-hidden="true">
              <label for="cf-hp">Để trống ô này</label>
              <input id="cf-hp" name="cf_hp" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <div id="cf-error" class="hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-[0.875rem] text-red-800" role="alert">
              <p id="cf-error-text"></p>
              <p id="cf-fallback" class="mt-1 hidden">Bạn có thể gọi <a class="font-semibold underline-offset-2 hover:underline" href={site.publicPhoneHref}>{site.publicPhone}</a> hoặc <a id="cf-mailto" class="font-semibold underline-offset-2 hover:underline" href={site.publicEmailHref}>gửi email tới {site.publicEmail}</a> (thư đã điền sẵn nội dung bạn vừa nhập).</p>
            </div>

            <button
              type="submit"
              id="cf-submit"
              class="inline-flex items-center gap-2 rounded-full bg-ink-black px-7 py-3 text-[0.9375rem] font-medium text-white transition-colors hover:bg-ink-hover active:scale-[0.97]"
            >
              Gửi yêu cầu
            </button>
            </div>
          </div>

          <div id="cf-success" role="status" tabindex="-1" class="hidden min-h-[34rem] flex flex-col justify-center relative overflow-hidden rounded-xl border border-border-soft px-8 py-8 focus:outline-none">
            <Image
              src={contactSuccessBg}
              alt=""
              class="absolute inset-0 h-full w-full object-cover"
              widths={[320, 640]}
              sizes="(min-width: 640px) 640px, 100vw"
              quality={80}
            />
            <div class="relative z-10 max-w-md">
              <p class="font-sans text-[2.125rem] font-[657] leading-tight tracking-[-0.02em] text-white">Đã gửi yêu cầu của bạn.</p>
              <p class="prose-justify mt-4 font-sans text-[1.1875rem] leading-relaxed text-white">CNN Legal đã nhận được thông tin và sẽ liên hệ lại trong thời gian sớm nhất. Nếu cần trao đổi gấp, bạn gọi trực tiếp {site.publicPhone} hoặc gửi email tới {site.publicEmail}.</p>{consentVersion && <p id="cf-reference" class="hidden mt-4 font-sans text-[1.1875rem] leading-relaxed text-white"></p>}
            </div>
          </div>
          </form>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const mapFrame = document.querySelector<HTMLIFrameElement>('iframe[data-map-src]');
  if (mapFrame) {
    const loadMap = () => {
      if (!mapFrame.src) mapFrame.src = mapFrame.dataset.mapSrc!;
    };
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            loadMap();
            observer.disconnect();
          }
        },
        // Khởi động sớm 200px. Bản đồ nằm dưới mép màn 340px (Lighthouse mobile)
        // và 348px (Lighthouse desktop) nên ngưỡng này không bao giờ tự nổ khi
        // trang chỉ được tải mà không cuộn.
        { rootMargin: '200px 0px' }
      );
      observer.observe(mapFrame);
    } else {
      loadMap();
    }
  }

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const fieldsContainer = document.getElementById('cf-fields') as HTMLDivElement;
  const successMsg = document.getElementById('cf-success') as HTMLDivElement;
  const errorMsg = document.getElementById('cf-error') as HTMLDivElement;
  const errorText = document.getElementById('cf-error-text') as HTMLParagraphElement;
  const fallback = document.getElementById('cf-fallback') as HTMLParagraphElement;
  const mailLink = document.getElementById('cf-mailto') as HTMLAnchorElement;

  const submitBtn = document.getElementById('cf-submit') as HTMLButtonElement;
  let sending = false;

  // withFallback: lỗi khách không tự sửa được (máy chủ, MisarMail, mạng) thì kèm số điện thoại
  // và thư soạn sẵn, để liên hệ không bị mất.
  const showError = (text: string, withFallback = false) => {
    errorText.textContent = text;
    fallback.classList.toggle('hidden', !withFallback);
    errorMsg.classList.remove('hidden');
  };

  type Fields = { name: string; phone: string; email: string; field: string; subject: string; message: string };

  // Thư soạn sẵn cho ứng dụng email của khách, cùng khuôn với thư máy chủ gửi. Cả đường link giữ
  // dưới khoảng 2.000 ký tự (mức nhiều ứng dụng mail còn mở được); dài hơn thì cắt bớt phần nội
  // dung, bản đầy đủ vẫn còn trong ô Nội dung vì form không bị xoá khi lỗi.
  const mailtoHref = (d: Fields) => {
    // Nửa cặp surrogate (đôi khi lẫn vào khi dán chữ) làm encodeURIComponent ném lỗi; thay bằng �.
    const enc = (s: string) => encodeURIComponent(s.replace(/\p{Cs}/gu, '\uFFFD'));
    const subject = `[CNN Legal] ${d.field}${d.subject ? ` – ${d.subject}` : ''} – ${d.name}`;
    const head = [
      `Họ tên: ${d.name}`,
      `Điện thoại: ${d.phone}`,
      `Email: ${d.email || '(không cung cấp)'}`,
      `Lĩnh vực: ${d.field}`,
      `Tiêu đề: ${d.subject || '(không có)'}`,
      '',
      '',
    ].join('\r\n');
    const base = `mailto:${form.dataset.email}?subject=${enc(subject)}&body=`;
    // Xuống dòng trong mailto phải là CRLF (RFC 6068); ô Nội dung chỉ trả về LF.
    const message = d.message.replace(/\n/g, '\r\n');
    let chars = Array.from(message);
    let href = base + enc(head + message);
    while (href.length > 2000 && chars.length) {
      chars = chars.slice(0, Math.floor(chars.length * 0.9));
      href = base + enc(`${head}${chars.join('')}…`);
    }
    return href;
  };

  if (import.meta.env.PUBLIC_CONTACT_API_URL) {
    // Turnstile chỉ tải khi khách bắt đầu điền form: lượt xem trang (và Lighthouse) không tải thêm gì.
    form.addEventListener(
      'focusin',
      () => void import('../scripts/contact-platform').then((m) => m.prepare()).catch(() => {}),
      { once: true },
    );
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (sending) return;
    errorMsg.classList.add('hidden');

    const data = {
      name: (form.elements.namedItem('name') as HTMLInputElement).value.trim(),
      phone: (form.elements.namedItem('phone') as HTMLInputElement).value.trim(),
      email: (form.elements.namedItem('email') as HTMLInputElement).value.trim(),
      field: (form.elements.namedItem('field') as HTMLSelectElement).value,
      subject: (form.elements.namedItem('subject') as HTMLInputElement).value.trim(),
      message: (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim(),
      cf_hp: (form.elements.namedItem('cf_hp') as HTMLInputElement).value,
    };

    if (!data.name || !data.phone || !data.field || !data.message) {
      showError('Vui lòng điền đầy đủ các trường bắt buộc (*)');
      return;
    }

    sending = true;
    const label = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Đang gửi…';

    try {
      const res = import.meta.env.PUBLIC_CONTACT_API_URL
        ? await (await import('../scripts/contact-platform')).submit(form, data)
        : await fetch('/api/v1/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
            // Mạng treo thì sau 40 giây coi như lỗi, để khách còn kịp gọi điện hoặc gửi email.
            signal: AbortSignal.timeout?.(40_000),
          });
      const payload = await res.json().catch(() => ({}));
      if (!res.ok) {
        // 400 và 413 là dữ liệu khách tự sửa được; mọi lỗi khác thì kèm cách liên hệ khác.
        const stuck = res.status !== 400 && res.status !== 413;
        if (stuck) mailLink.href = mailtoHref(data);
        showError(payload.error || 'Không gửi được lúc này, bạn thử lại sau nhé.', stuck);
        return;
      }
      form.reset();
      fieldsContainer.classList.add('hidden');
      successMsg.classList.remove('hidden');
      successMsg.focus();
    } catch {
      mailLink.href = mailtoHref(data);
      showError('Không kết nối được máy chủ, bạn thử lại sau nhé.', true);
    } finally {
      sending = false;
      submitBtn.disabled = false;
      submitBtn.textContent = label;
    }
  });
</script>
