---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AskBox from "../../components/AskBox.astro";
import { notableCases } from "../../data/cases";
import { site } from "../../data/site";

export function getStaticPaths() {
  return notableCases.map((c) => ({
    params: { slug: c.slug },
    props: { caseItem: c },
  }));
}

const { caseItem } = Astro.props;

const title = `${caseItem.title} | ${site.name}`;
const canonicalPath = `/vu-an-tieu-bieu/${caseItem.slug}/`;
const pageUrl = new URL(canonicalPath, site.canonicalBaseUrl).toString();
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: caseItem.title,
    description: caseItem.summary,
    url: pageUrl,
    inLanguage: "vi-VN",
    author: {
      "@type": "Organization",
      name: site.name,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Trang chủ", item: site.canonicalBaseUrl },
      { "@type": "ListItem", position: 2, name: "Kinh nghiệm", item: new URL("/kinh-nghiem/", site.canonicalBaseUrl).toString() },
      { "@type": "ListItem", position: 3, name: caseItem.title, item: pageUrl },
    ],
  },
];
---

<BaseLayout title={title} description={caseItem.summary} canonicalPath={canonicalPath} structuredData={structuredData}>

  <div class="bg-surface-white">
    <div class="section-shell pb-12 pt-[calc(3rem+var(--nav-h))] md:pb-16 md:pt-[calc(4rem+var(--nav-h))]">
      <div class="mx-auto max-w-3xl">

        
        <div class="flex flex-wrap items-center gap-2 text-[0.8125rem] font-medium text-text-muted">
          <span>{caseItem.date || caseItem.year}</span>
          {caseItem.court && (
            <>
              <span aria-hidden="true">|</span>
              <span>{caseItem.court}</span>
            </>
          )}
        </div>

        <h1 class="mt-5 text-balance text-[1.75rem] font-bold leading-[1.25] text-text-dark md:text-[2rem] lg:text-[2.25rem]">
          {caseItem.title}
        </h1>

        
        {(caseItem.role || caseItem.defendant) && (
          <div class="mt-8 grid gap-4 rounded-xl border border-border-soft bg-surface-subtle p-5 sm:grid-cols-2 lg:grid-cols-4">
            {caseItem.role && <div>
              <p class="text-[0.625rem] font-semibold uppercase tracking-[0.08em] text-text-muted">Vai trò</p>
              <p class="mt-1 text-[0.8125rem] font-medium text-text-dark">{caseItem.role}</p>
            </div>}
            {caseItem.defendant && <div>
              <p class="text-[0.625rem] font-semibold uppercase tracking-[0.08em] text-text-muted">Bị cáo</p>
              <p class="mt-1 text-[0.8125rem] font-medium text-text-dark">{caseItem.defendant}</p>
            </div>}
          </div>
        )}

        <div class="prose-legal mt-10 text-[0.9375rem] leading-[1.85] text-text-dark" set:html={caseItem.body} />

        {caseItem.keyArguments.length > 0 && (
          <div class="mt-10">
            <h2 class="text-[1rem] font-bold text-text-dark">Luận điểm bào chữa chính</h2>
            <ul class="mt-4 space-y-3">
              {caseItem.keyArguments.map((arg) => (
                <li class="flex gap-3 text-[0.875rem] leading-[1.75] text-text-dark">
                  <span class="shrink-0 font-medium text-text-dark" aria-hidden="true">–</span>
                  <span>{arg}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {caseItem.result && (
          <div class="mt-10 flex items-center gap-3 rounded-xl border border-green-100 bg-green-50 px-6 py-4">
            <svg class="h-5 w-5 shrink-0 text-green-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            <div>
              <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.06em] text-green-700">Kết quả</p>
              <p class="text-[0.875rem] font-medium text-green-800">{caseItem.result}</p>
            </div>
          </div>
        )}

        {caseItem.sources.length > 0 && (
          <div class="mt-10 border-t border-border-soft pt-8">
            <h2 class="text-[1rem] font-bold text-text-dark">Nguồn tham khảo</h2>
            
            <ul class="mt-4 space-y-4">
              {caseItem.sources.map((source) => (
                <li>
                  <a
                    class="text-[1.0625rem] leading-snug text-[#1a4a9e] hover:text-[#0f2f6b] hover:underline underline-offset-2"
                    href={source.url}
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    {source.title || source.name}
                  </a>
                  <p class="mt-1 text-[0.8125rem] text-text-muted">
                    {source.name}{source.publishedAt ? ` — ${source.publishedAt}` : ""}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="mt-10 border-t border-border-soft pt-8">
          <a
            href="/kinh-nghiem/"
            class="inline-flex items-center gap-2 text-[0.875rem] font-medium text-deep-blue-navy hover:text-professional-blue"
          >
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M13 8H3M7 4L3 8l4 4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>Quay lại Kinh nghiệm</span>
          </a>
        </div>

        <div class="h-24" aria-hidden="true"></div>
      </div>
    </div>
  </div>

  <AskBox subject="vụ án" />
</BaseLayout>

<style>
  .prose-legal :global(p) {
    margin-bottom: 1.25rem;
  }
  .prose-legal :global(p:last-child) {
    margin-bottom: 0;
  }
  .prose-legal :global(strong) {
    color: var(--color-text-dark);
    font-weight: 600;
  }
  .prose-legal :global(h2) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-dark);
  }
  .prose-legal :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-dark);
  }
  .prose-legal :global(ul) {
    margin-bottom: 1.25rem;
    padding-left: 1.125rem;
    list-style: disc;
  }
  .prose-legal :global(li) {
    margin-bottom: 0.5rem;
  }
  .prose-legal :global(li:last-child) {
    margin-bottom: 0;
  }
</style>
