---
import { Picture } from "astro:assets";
import HeroBreadcrumb from "../../components/HeroBreadcrumb.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { notableCases } from "../../data/cases";
import { site } from "../../data/site";
import experienceHero from "../../assets/images/experience-river.jpg";

const title = `Kinh nghiệm | ${site.name}`;
const description =
  "Các vụ án, vụ việc tiêu biểu mà Luật sư Đặng Kim Chinh cùng cộng sự CNN Legal đã tham gia giải quyết.";
const canonicalPath = "/kinh-nghiem/";
const pageUrl = new URL(canonicalPath, site.canonicalBaseUrl).toString();
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: pageUrl,
    inLanguage: "vi-VN",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Trang chủ", item: site.canonicalBaseUrl },
      { "@type": "ListItem", position: 2, name: "Kinh nghiệm", item: pageUrl },
    ],
  },
];
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} structuredData={structuredData}>
  <section class="relative overflow-hidden py-20 md:py-28 lg:py-32">
    <div class="absolute inset-0 z-0" style="background-color:#8cabbf">
      {/* Banner màn hẹp cao 254px; dưới 400px tiêu đề xuống hai dòng, banner cao 295px
          nên ảnh 3:2 phóng theo chiều cao, rộng ≈ 443px. Banner desktop chỉ lộ ~29% chiều
          cao ảnh mà dãy nhà trải 26–58%, nên tiêu điểm 42% giữ đỉnh phần lớn toà nhà lẫn
          bờ sông.
          quality 65: giống ảnh gốc ngang WebP 80 (SSIM 0,977 so với 0,978). */}
      <Picture
        class="h-full w-full object-cover"
        style="object-position:50% 42%"
        src={experienceHero}
        alt="Sông chảy qua thành phố nhiều nhà cao tầng"
        formats={["avif"]}
        fallbackFormat="webp"
        widths={[640, 768, 960, 1280, 1600, 1920, 2560, 3840]}
        sizes="(max-width: 399px) 443px, 100vw"
        quality={65}
        loading="eager"
        fetchpriority="high"
      />
      {/* Phủ tối đều 20%, không gradient: chữ trắng nằm trên dãy nhà trắng, 20% là mức
          nhẹ nhất đưa tương phản tiêu đề lên ~3:1 (trung vị, từ ~2:1) mà ảnh vẫn sáng. */}
      <div class="absolute inset-0" style="background-color:rgb(0 0 0 / 0.2)"></div>
    </div>

    <div class="section-shell relative z-10">
      <HeroBreadcrumb items={[{ label: "Trang chủ", href: "/" }, { label: "Kinh nghiệm" }]} />

      <h1 class="mt-8 text-balance max-w-4xl font-sans text-[2.25rem] font-semibold leading-[1.14] tracking-[-0.01em] text-white md:text-[2.75rem] lg:text-[3.125rem]">
        Kinh nghiệm thực tiễn
      </h1>
    </div>
  </section>

  <section class="bg-panel-taupe">
    <div class="section-shell py-16 md:py-20">
      <h2 class="font-sans text-[2rem] font-semibold tracking-[-0.01em] text-text-dark">
        Vụ án tiêu biểu
      </h2>

      <p class="prose-justify mt-4 max-w-3xl font-sans text-[1rem] leading-[1.8] text-text-dark md:text-[1.0625rem]">
        Luật sư Đặng Kim Chinh — người sáng lập CNN Legal cùng cộng sự đã tham gia giải quyết nhiều vụ án, vụ việc tiêu biểu trong các lĩnh vực hình sự, dân sự và hành chính.
      </p>

      <p class="prose-justify mt-4 max-w-3xl font-sans text-[0.9375rem] leading-[1.8] text-text-muted">
        Do yêu cầu bảo mật thông tin khách hàng, chuyên mục này chỉ giới thiệu những vụ án, vụ việc đã được các cơ quan báo chí công khai phản ánh. Thông tin giới thiệu được trích dẫn và tổng hợp trong phạm vi nội dung đã được các cơ quan báo chí đăng tải công khai.
      </p>

      <ul class="mt-10 grid grid-cols-1 gap-5 lg:grid-cols-2">
        {notableCases.map((item) => (
          <li>
            <a
              class="group flex h-full flex-col rounded-xl border border-border-soft bg-surface-white p-7 transition-all hover:border-text-muted/30 hover:shadow-[0_4px_16px_rgba(15,25,35,0.08)]"
              href={`/vu-an-tieu-bieu/${item.slug}/`}
            >
              
              <span class="text-[0.875rem] font-semibold text-text-muted">
                {item.category}
              </span>
              <h3 class="mt-2.5 text-balance text-[1.125rem] font-semibold leading-snug text-text-dark">
                {item.title}
              </h3>
              <p class="prose-justify mt-3.5 text-[0.875rem] leading-[1.75] text-text-muted">{item.summary}</p>
              {item.court && (
                <span class="mt-4 text-[0.8125rem] text-text-muted">{item.court}</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
