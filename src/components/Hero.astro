---
import { getImage } from "astro:assets";
import { site } from "../data/site";
import heroSaigon from "../assets/images/hero-saigon.jpg";
import heroSaigonTall from "../assets/images/hero-saigon-portrait.jpg";

// Bỏ lớp phủ tối thì lỗi nén lộ hết: ở quality 40 dây văng đứt đoạn, mất sợi và toà nhà
// nhoè (giữ 63–68% năng lượng biên so với ảnh gốc thu nhỏ); 60 giữ 80–84%. Bản dọc là ảnh
// LCP của Lighthouse mobile (bản 960w) nên giữ 40: đo 5 lượt, 43 KB → LCP 1,5 s, 100 điểm;
// 45 (57 KB) → 1,66 s, sát mốc tụt; 50–60 (71–111 KB) → 1,8 s, 99 điểm.
const QUALITY_WIDE = 60;
const QUALITY_TALL = 40;
const [tallAvif, wideAvif, wideWebp] = await Promise.all([
  getImage({ src: heroSaigonTall, widths: [640, 960, 1280, 1440], format: "avif", quality: QUALITY_TALL }),
  getImage({ src: heroSaigon, widths: [640, 960, 1280, 1600, 2048, 2560], format: "avif", quality: QUALITY_WIDE }),
  getImage({ src: heroSaigon, widths: [640, 960, 1280, 1600, 2048, 2560], format: "webp", quality: QUALITY_WIDE }),
]);

// Ảnh 3:2 phủ kín hero → khung hẹp hơn 3/2 thì object-cover phóng theo CHIỀU CAO:
// 1,5 × 100vh = 150vh.
const WIDE_SIZES = "(min-aspect-ratio: 3/2) 100vw, 150vh";
// Màn dựng đứng dùng bản cắt 9:16 quanh cầu Ba Son: bản ngang ở đó chỉ hiện chừng
// một phần ba bề ngang mà vẫn phải tải file 2560w. Đo Lighthouse mobile: bản ngang
// đẩy LCP 1.882 → 2.254 ms. Hẹp hơn 9/16 thì phóng theo chiều cao: 0,5625 × 100vh.
const TALL_SIZES = "(min-aspect-ratio: 9/16) 100vw, 57vh";
---

{/* Cao trọn phần còn lại dưới header của khung khoá cuộn (BaseLayout lockViewport). */}
<section class="relative h-full overflow-hidden bg-ink-black">

  <div class="hero-bg-image absolute inset-0">
    <picture>
      <source media="(max-aspect-ratio: 3/4)" type="image/avif" srcset={tallAvif.srcSet.attribute} sizes={TALL_SIZES} />
      <source type="image/avif" srcset={wideAvif.srcSet.attribute} sizes={WIDE_SIZES} />
      <img
        class="absolute inset-0 h-full w-full object-cover"
        src={wideWebp.src}
        srcset={wideWebp.srcSet.attribute}
        sizes={WIDE_SIZES}
        alt="Sông Sài Gòn với cầu Ba Son và tòa Landmark 81"
        width={heroSaigon.width}
        height={heroSaigon.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>

  <div class="hero-copy relative flex h-full flex-col px-6 pt-[24dvh] sm:px-10 md:px-16 xl:px-20">

    <h1 class="hero-title font-sans font-semibold leading-[1.15] tracking-[-0.02em] text-white">
      {site.sloganLines.map((line) => (
        <span class="block">{line}</span>
      ))}
    </h1>
  </div>
</section>

<style>
  .hero-copy {
    container-type: inline-size;
  }

  .hero-title {
    font-size: 2rem;
    /* Hàm bậc nhất có hệ số tự do: đủ lớn trên màn hẹp mà vẫn không xuống dòng,
       đồng thời không phình quá cỡ khi khung chữ rộng hết màn hình */
    font-size: clamp(1.375rem, 0.77rem + 3.41cqi, 3.5rem);
  }

  .hero-title span {
    text-wrap: balance;
  }

  /* Ảnh ngang: slogan phải nằm trên nền trời. Chữ trải 6–56% bề ngang, phủ qua đỉnh
     trụ cầu (≈37,6% chiều cao ảnh) và dãy nhà bên trái (≈43%). Căn giữa với slogan cách
     đỉnh 24% thì đáy chữ rơi vào 45–48% ở mọi khổ màn → đè. Dời tiêu điểm ảnh lên 28% và
     slogan lên 16% chiều cao màn: dò trên 11 khổ 1024–2560, đáy chữ ≤ 35,8% chiều cao ảnh,
     mép dưới vẫn thấy tới ≥ 74% (cầu và thuyền). Ảnh dọc không đè nên không đổi. */
  @media not all and (max-aspect-ratio: 3/4) {
    .hero-bg-image img {
      object-position: 50% 28%;
    }

    .hero-copy {
      padding-top: 16dvh;
    }
  }
</style>
