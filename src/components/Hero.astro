---
import { Image, Picture } from "astro:assets";
import { site } from "../data/site";
import heroRadialLines from "../assets/images/hero-gradient.jpg";
import carousel1 from "../assets/images/carousel-1.jpg";
import carousel3 from "../assets/images/carousel-3.jpg";
---

{/* Cao trọn phần <main> của khung khoá cuộn (BaseLayout lockViewport) */}
<section class="relative h-full overflow-hidden bg-ink-black" data-hero>

  <div class="hero-bg-image active absolute inset-0 transition-opacity duration-700 ease-in-out">
    {/* Ảnh LCP: AVIF cho máy hỗ trợ, WebP dự phòng — WebP nén hạt nhiễu của ảnh
        này kém hơn AVIF tới 5 lần (258 KB so với 50 KB ở 2560w).
        quality 30 là ngưỡng thấp nhất còn giữ được hạt: xuống 25 là hạt vón mảng.
        Nguồn đã lật ngang để vùng tối nằm bên trái đỡ chữ trắng, và thu về 2560px
        để ảnh dự phòng <img src> không thành file 5120w nặng 723 KB. */}
    <Picture
      class="absolute inset-0 h-full w-full object-cover"
      src={heroRadialLines}
      alt="CNN Legal – Tư vấn pháp lý chuyên nghiệp"
      formats={["avif"]}
      fallbackFormat="webp"
      widths={[640, 960, 1280, 1600, 2048, 2560]}
      {/* Ảnh 16:9 nhét vào khung hero → object-cover phóng theo CHIỀU CAO khi
          khung nhìn dựng đứng, nên phải khai theo vh chứ không phải vw, nếu không
          điện thoại sẽ tải file 640w rồi phóng 2,3 lần. Ngưỡng 5/3 chứ không phải
          16/9: hero thấp hơn khung nhìn 61px, và 16/9 rơi đúng ranh giới màn 1080p
          nên chỉ cần thanh cuộn là lật sang nhánh sai. */}
      sizes="(min-aspect-ratio: 5/3) 105vw, 190vh"
      quality={30}
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="hero-bg-image absolute inset-0 transition-opacity duration-700 ease-in-out opacity-0">
    <Image
      class="absolute inset-0 h-full w-full object-cover"
      src={carousel1}
      alt="CNN Legal – Dịch vụ pháp lý"
      widths={[640, 768, 1024, 1280, 1536, 1763]}
      sizes="105vw"
      quality={80}
      loading="eager"
      fetchpriority="low"
    />
  </div>

  <div class="hero-bg-image absolute inset-0 transition-opacity duration-700 ease-in-out opacity-0">
    <Image
      class="absolute inset-0 h-full w-full object-cover"
      src={carousel3}
      alt="CNN Legal – Tư vấn chuyên nghiệp"
      widths={[640, 768, 1024, 1280, 1536, 1672]}
      sizes="105vw"
      quality={80}
      loading="eager"
      fetchpriority="low"
    />
  </div>

  {/* Lớp phủ tối: giữ chữ trắng đọc được trên cả 3 ảnh, kể cả ảnh sáng nhất */}
  <div class="hero-scrim pointer-events-none absolute inset-0 z-10"></div>

  <div class="hero-copy relative z-20 flex h-full flex-col justify-start px-6 pt-[24dvh] sm:px-10 md:px-16 xl:px-20">

    <h1 class="hero-title font-sans font-semibold leading-[1.15] tracking-[-0.02em] text-white">
      {site.sloganLines.map((line) => (
        <span class="block">{line}</span>
      ))}
    </h1>
  </div>

  <div class="hero-dots absolute bottom-10 left-6 z-30 flex gap-2 pb-[env(safe-area-inset-bottom)] sm:left-10 md:left-16 xl:left-20">
    <button
      type="button"
      class="progress-indicator active relative h-1 w-16 bg-white/45 rounded-full focus:outline-none cursor-pointer border-0 p-0"
      data-index="0"
      aria-label="Go to slide 1"
    >
      <div class="progress-fill h-full bg-white rounded-full w-0"></div>
    </button>
    <button
      type="button"
      class="progress-indicator relative h-1 w-16 bg-white/45 rounded-full focus:outline-none cursor-pointer border-0 p-0"
      data-index="1"
      aria-label="Go to slide 2"
    >
      <div class="progress-fill h-full bg-white rounded-full w-0"></div>
    </button>
    <button
      type="button"
      class="progress-indicator relative h-1 w-16 bg-white/45 rounded-full focus:outline-none cursor-pointer border-0 p-0"
      data-index="2"
      aria-label="Go to slide 3"
    >
      <div class="progress-fill h-full bg-white rounded-full w-0"></div>
    </button>
  </div>
</section>

<style>
  .hero-copy {
    container-type: inline-size;
  }

  .hero-title {
    font-size: 2rem;
    /* Hàm bậc nhất có hệ số tự do: đủ lớn trên màn hẹp mà vẫn không xuống dòng,
       đồng thời không phình quá cỡ khi khung chữ rộng hết màn hình */
    font-size: clamp(1.375rem, 0.77rem + 3.41cqi, 3.5rem);
  }

  .hero-title span {
    text-wrap: balance;
  }

  /* Đậm về bên trái nơi đặt tiêu đề, nhạt dần để lộ ảnh bên phải */
  .hero-scrim {
    background:
      linear-gradient(
        100deg,
        rgba(15, 25, 35, 0.94) 0%,
        rgba(15, 25, 35, 0.86) 22%,
        rgba(15, 25, 35, 0.62) 45%,
        rgba(15, 25, 35, 0.28) 68%,
        rgba(15, 25, 35, 0.06) 88%,
        rgba(15, 25, 35, 0) 100%
      ),
      linear-gradient(
        180deg,
        rgba(15, 25, 35, 0.3) 0%,
        rgba(15, 25, 35, 0) 30%,
        rgba(15, 25, 35, 0) 62%,
        rgba(15, 25, 35, 0.42) 100%
      );
  }

  /* Màn hẹp: chữ chiếm gần hết bề ngang nên phủ đều thay vì dồn trái */
  @media (max-width: 1023px) {
    .hero-scrim {
      background: linear-gradient(
        180deg,
        rgba(15, 25, 35, 0.62) 0%,
        rgba(15, 25, 35, 0.5) 45%,
        rgba(15, 25, 35, 0.66) 100%
      );
    }
  }

  .hero-bg-image {
    opacity: 0;
    transition: opacity 700ms ease-in-out;
  }

  .hero-bg-image.active {
    opacity: 1;
  }

  .hero-bg-image img {

    /* Để trình duyệt nội suy trơn. Tránh -webkit-optimize-contrast: Firefox hiểu
       nó là crisp-edges (lấy mẫu điểm gần nhất) nên ảnh phóng to bị răng cưa. */
    image-rendering: auto;

    will-change: opacity;
  }

  /* Chỉ bật hiệu ứng khi thật sự có chuột và người dùng không tắt chuyển động.
     Nới ảnh rộng hơn khung 5% rồi CHỈ tịnh tiến, không scale: lớp ảnh được
     dựng đúng tỉ lệ 1:1 nên không bị GPU phóng lại làm nhoè và răng cưa. */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    [data-hero] .hero-bg-image {
      inset: -2.5%;
      will-change: opacity, transform;
    }
  }

  /* Vạch dày 4px nên tách khỏi ảnh sáng bằng bóng đổ, khỏi bị chìm */
  .hero-dots {
    filter: drop-shadow(0 1px 3px rgba(15, 25, 35, 0.65));
  }

  /* Nới vùng chạm lên 32px mà không đổi hình dạng nhìn thấy:
     4px thì không tài nào bấm trúng trên máy cảm ứng */
  .progress-indicator::after {
    content: "";
    position: absolute;
    inset: -14px -4px;
  }

  .progress-indicator.active .progress-fill {
    animation: fillProgress 3s linear forwards;
  }

  @keyframes fillProgress {
    from {
      width: 0%;
    }
    to {
      width: 100%;
    }
  }

  .progress-indicator:not(.active) .progress-fill {
    width: 0%;
    animation: none;
  }
</style>

<script is:inline>

  (function() {

    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }

    function initSlider() {
      if (window.heroRotationInterval) {
        clearInterval(window.heroRotationInterval);
      }

      const bgImages = document.querySelectorAll('.hero-bg-image');
      const indicators = document.querySelectorAll('.progress-indicator');

      if (bgImages.length === 0 || indicators.length === 0) {
        return;
      }

      let currentIndex = 0;
      const totalSlides = Math.min(bgImages.length, indicators.length);
      const rotationInterval = 3000;

      function showSlide(index) {

        bgImages.forEach(function(img) { img.classList.remove('active'); });
        indicators.forEach(function(ind) {
          ind.classList.remove('active');
          const fill = ind.querySelector('.progress-fill');
          if (fill) {

            void fill.offsetWidth;
          }
        });

        bgImages[index].classList.add('active');
        indicators[index].classList.add('active');
      }

      function nextSlide() {
        currentIndex = (currentIndex + 1) % totalSlides;
        showSlide(currentIndex);
      }

      function resetRotation() {
        if (window.heroRotationInterval) {
          clearInterval(window.heroRotationInterval);
        }
        window.heroRotationInterval = setInterval(nextSlide, rotationInterval);
      }

      indicators.forEach(function(ind, idx) {
        ind.onclick = function() {
          currentIndex = idx;
          showSlide(currentIndex);
          resetRotation();
        };
      });

      showSlide(0);

      window.heroRotationInterval = setInterval(nextSlide, rotationInterval);
    }

    function initParallax() {
      const hero = document.querySelector('[data-hero]');

      if (!hero || hero.dataset.parallax) {
        return;
      }

      if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches ||
          window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        return;
      }

      hero.dataset.parallax = '1';

      const layers = hero.querySelectorAll('.hero-bg-image');
      let targetX = 0, targetY = 0, curX = 0, curY = 0;
      let frame = 0, settledFrames = 0;
      let box = hero.getBoundingClientRect();

      function tick() {

        curX += (targetX - curX) * 0.075;
        curY += (targetY - curY) * 0.075;

        const shift = 'translate3d(' + (curX * -0.9).toFixed(3) + '%,' +
                                       (curY * -0.9).toFixed(3) + '%,0)';

        for (let i = 0; i < layers.length; i++) {
          layers[i].style.transform = shift;
        }

        const settled = Math.abs(targetX - curX) < 0.004 && Math.abs(targetY - curY) < 0.004;
        settledFrames = settled ? settledFrames + 1 : 0;

        if (settledFrames > 4) {

          frame = 0;
          return;
        }

        frame = requestAnimationFrame(tick);
      }

      function kick() {
        if (!frame) {
          frame = requestAnimationFrame(tick);
        }
      }

      hero.addEventListener('pointermove', function(event) {

        targetX = ((event.clientX - box.left) / box.width) * 2 - 1;
        targetY = ((event.clientY - box.top) / box.height) * 2 - 1;
        kick();
      });

      hero.addEventListener('pointerleave', function() {
        targetX = 0;
        targetY = 0;
        kick();
      });

      window.addEventListener('resize', function() {
        box = hero.getBoundingClientRect();
      });
    }

    window.addEventListener('pageshow', function(event) {

      if (!event.persisted) {
        window.scrollTo(0, 0);
        document.documentElement.scrollTop = 0;
        document.body.scrollTop = 0;
      }

      initSlider();
      initParallax();
    });
  })();
</script>
