---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
// Chữ trắng đặc: chữ 13px cần 4,5:1 mà trắng trong suốt 35% trên nền đen tuyệt đối cũng chỉ
// được 3:1. Dấu ngăn chỉ để trang trí (aria-hidden) nên vẫn để mờ, bằng thuộc tính opacity của
// SVG chứ không bằng lớp màu trắng trong suốt riêng (lớp đó nằm trong CSS của mọi trang).
---

<nav class="text-[0.8125rem] font-medium text-white" aria-label="Đường dẫn">
  {items.map((item, i) => (
    <>
      {i > 0 && (
        <svg class="mx-1.5 inline-block h-3 w-3" opacity=".25" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M4.5 2.5L7.5 6L4.5 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      )}
      {item.href ? (
        <a class="hover:underline underline-offset-2" href={item.href}>{item.label}</a>
      ) : (
        <span class="font-semibold" aria-current="page">{item.label}</span>
      )}
    </>
  ))}
</nav>
