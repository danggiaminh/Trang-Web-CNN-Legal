---
interface Props {
  subject?: string;
}

const { subject = "bài viết" } = Astro.props;
const askPlaceholder = `Hỏi bất cứ điều gì về ${subject} này...`;
const suggestions = [`Tóm tắt ${subject} này`, `Phân tích các ý trong ${subject} này`];
---

<div
  class="pointer-events-none fixed inset-x-0 bottom-0 z-40 px-4 pb-7"
  data-ask-box
  data-at-top
>
  <form
    class="pointer-events-auto mx-auto w-full max-w-[25rem] rounded-[1rem] border border-border-soft bg-surface-white pb-1 pl-3.5 pr-1.5 pt-3 shadow-[0_6px_20px_-6px_rgba(15,25,35,0.16)] transition-colors duration-150 focus-within:border-text-dark"
    data-ask-form
  >
    <label class="sr-only" for="ask-input">Đặt câu hỏi về nội dung này</label>
    <input
      id="ask-input"
      name="question"
      type="text"
      autocomplete="off"
      class="block w-full bg-transparent text-[0.875rem] leading-4 text-text-dark placeholder:text-text-muted focus:outline-none"
      placeholder={askPlaceholder}
      data-ask-input
    />

    <div class="mt-0.5 flex items-center justify-end gap-2.5">
      <kbd
        class="hidden shrink-0 font-sans text-[0.75rem] font-normal text-text-muted sm:block"
        data-ask-hint
      >
        Ctrl+I
      </kbd>

      <button
        type="submit"
        class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-ink-black text-white transition-colors disabled:cursor-not-allowed disabled:opacity-40"
        aria-label="Gửi câu hỏi"
        disabled
        data-ask-submit
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M8 12.5V3.5M4.5 7L8 3.5L11.5 7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </form>
</div>

<div class="pointer-events-none fixed inset-0 z-[60] overflow-hidden" data-ask-panel-wrap>
<aside
  class="pointer-events-auto absolute inset-0 flex w-full translate-x-[calc(100%+1.5rem)] flex-col border-border-soft bg-surface-white transition-transform duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] sm:inset-y-3 sm:left-auto sm:right-3 sm:w-[23rem] sm:rounded-2xl sm:border"
  aria-label="Trợ lý hỏi đáp"
  aria-hidden="true"
  inert
  data-ask-panel
>
  <header class="flex shrink-0 items-center justify-between px-4 py-3.5">
    <div class="flex items-center gap-2">
      <svg class="h-4 w-4 text-text-dark" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8 0.5l1.6 4.3 4.3 1.6-4.3 1.6L8 12.3 6.4 8 2.1 6.4l4.3-1.6L8 0.5zM13 10.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7.7-1.8z" />
      </svg>
      <span class="text-[0.9375rem] font-semibold text-text-dark">Trợ lý bài viết</span>
    </div>

    <div class="flex items-center gap-1">
      <kbd
        class="hidden font-sans text-[0.75rem] font-normal text-text-muted sm:block"
        data-ask-panel-hint
      >
        Ctrl+I
      </kbd>

      <button
        type="button"
        class="inline-flex h-7 w-7 items-center justify-center rounded-md text-text-muted transition-colors hover:bg-surface-subtle hover:text-text-dark"
        aria-label="Đóng"
        data-ask-close
      >
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M3.5 3.5l9 9M12.5 3.5l-9 9" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </header>

  <div
    class="flex shrink-0 items-center justify-between gap-2 px-4 py-3.5"
    role="status"
    hidden
    data-ask-limit
  >
    <p class="text-[0.8125rem] leading-[1.5] text-text-muted" data-ask-limit-text></p>

    <button
      type="button"
      class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md text-text-muted transition-colors hover:bg-surface-subtle hover:text-text-dark"
      aria-label="Đóng thông báo"
      data-ask-limit-close
    >
      <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M3.5 3.5l9 9M12.5 3.5l-9 9" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <div
    class="flex-1 space-y-5 overflow-y-auto px-4 py-4"
    role="log"
    aria-live="polite"
    data-ask-messages
  >
    <div class="space-y-4 pt-1" data-ask-welcome>
      <p class="font-sans text-[1.0625rem] font-semibold leading-[1.4] text-text-dark">
        Xin chào, tôi có thể giúp gì cho bạn?
      </p>
      <div class="grid grid-cols-2 gap-2">
        <button
          type="button"
          class="rounded-2xl border border-ink-black/60 bg-surface-white px-3 py-3 text-left text-[0.8125rem] font-medium leading-[1.45] text-text-dark transition-colors hover:bg-surface-subtle"
          data-ask-suggest
          data-ask-question={suggestions[0]}
        >
          {suggestions[0]}
        </button>
        <button
          type="button"
          class="rounded-2xl border border-ink-black/60 bg-surface-white px-3 py-3 text-left text-[0.8125rem] font-medium leading-[1.45] text-text-dark transition-colors hover:bg-surface-subtle"
          data-ask-suggest
          data-ask-question={suggestions[1]}
        >
          {suggestions[1]}
        </button>
      </div>
    </div>
  </div>

  <div class="shrink-0 px-4 pb-4">
    <form
      class="rounded-[1.25rem] border border-border-soft bg-surface-white pb-1.5 pl-3.5 pr-1.5 pt-3 transition-colors duration-150 focus-within:border-text-dark"
      data-ask-panel-form
    >
      <label class="sr-only" for="ask-panel-input">Nhập câu hỏi</label>
      <input
        id="ask-panel-input"
        name="question"
        type="text"
        autocomplete="off"
        class="block w-full bg-transparent text-[0.875rem] leading-4 text-text-dark placeholder:text-text-muted focus:outline-none"
        placeholder={askPlaceholder}
        data-ask-panel-input
      />

      <div class="mt-1.5 flex items-center justify-end">
        <button
          type="submit"
          class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-ink-black text-white invisible transition-colors disabled:cursor-not-allowed disabled:opacity-40"
          aria-label="Gửi câu hỏi"
          disabled
          data-ask-panel-submit
        >
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M8 12.5V3.5M4.5 7L8 3.5L11.5 7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </form>
  </div>
</aside>
</div>

<style>
  [data-has-text] [data-ask-hint] {
    display: none;
  }
  [data-ask-box][data-hidden] {
    opacity: 0;
    visibility: hidden;
  }

  [data-ask-box] {
    transition:
      transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 180ms ease,
      visibility 0s;
  }

  [data-ask-box][data-at-top] {
    transform: translateY(calc(100% + 1.5rem));
    opacity: 0;
    visibility: hidden;
    transition:
      transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 180ms ease,
      visibility 0s 220ms;
  }

  :global(body[data-ask-panel-open]) {
    overflow: hidden;
  }

  /* Bảng trợ lý rộng 23rem, cách mép phải 0.75rem. Khung trang co lại nhường chỗ: mép phải bảng
     nội dung (khung + --frame-gap) cách mép màn hình 24.5rem, chừa đúng 0.75rem giữa hai bảng. */
  @media (min-width: 640px) {
    :global(body[data-ask-panel-open] [data-app-shell]) {
      position: fixed;
      inset: 0 23.75rem 0 0;
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    :global(body[data-ask-panel-open] .site-frame) {
      right: 24.5rem;
    }
  }

  :global([data-ask-messages] > .ask-answer:has(+ .ask-copy)) {
    margin-block-end: 0;
  }

  :global(.ask-copy) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0.25rem 0.25rem;
    border-radius: 0.5rem;
    color: var(--color-text-muted);
    opacity: 0;
    transition: opacity 140ms ease-out, color 150ms ease-out,
      transform 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.ask-answer:hover + .ask-copy),
  :global(.ask-copy:hover),
  :global(.ask-copy:focus-visible),
  :global(.ask-copy[data-copied]) {
    opacity: 1;
  }

  :global(.ask-copy svg) {
    width: 1.0625rem;
    height: 1.0625rem;
  }

  :global(.ask-copy:hover),
  :global(.ask-copy:focus-visible) {
    color: var(--color-text-dark);
    transform: scale(1.08);
  }

  :global(.ask-copy[data-copied]) {
    color: var(--color-text-dark);
  }

  @media (hover: none) {
    :global(.ask-copy) {
      opacity: 1;
    }
  }

  /*
   * Máy tính bảng dựng đứng thì ẩn trợ lý AI.
   * Máy tính, máy tính bảng xoay ngang và điện thoại (mọi chiều) đều vẫn có.
   *
   * - min-width 600px: tách máy tính bảng khỏi điện thoại. Điện thoại rộng nhất
   *   khi dựng đứng khoảng 440px, iPad Mini hẹp nhất khoảng 744px.
   * - pointer: coarse: chỉ thiết bị cảm ứng. Thiếu điều kiện này thì người dùng
   *   máy tính thu hẹp cửa sổ cho cao và hẹp sẽ bị mất trợ lý oan.
   *
   * Script bên dưới dùng lại đúng chuỗi truy vấn này (hằng TABLET_PORTRAIT)
   * để đóng bảng khi người dùng xoay máy — sửa ở đây thì sửa cả ở đó.
   */
  @media (orientation: portrait) and (min-width: 600px) and (pointer: coarse) {
    [data-ask-box],
    [data-ask-panel-wrap] {
      display: none;
    }
  }

  /*
   * iOS Safari tự phóng to trang khi chạm vào ô nhập có chữ nhỏ hơn 16px. Chỉ nâng cỡ chữ trên
   * thiết bị cảm ứng; dùng chuột thì giữ 14px như thiết kế.
   */
  @media (pointer: coarse) {
    input {
      font-size: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.ask-copy) {
      transition: none;
    }
    :global(.ask-copy:hover),
    :global(.ask-copy:focus-visible) {
      transform: none;
    }
  }

  /*
   * Dòng trạng thái ("Đang suy nghĩ", "Đang tìm trên mạng") có một dải sáng
   * lướt ngang chữ. Kỹ thuật: nền gradient + background-clip:text, chữ để trong
   * suốt rồi cho nền chạy. Vì chữ trong suốt nên nhánh prefers-reduced-motion
   * BẮT BUỘC trả lại màu đặc, không thì người tắt hiệu ứng thấy chữ tàng hình.
   */
  :global(.ask-status) {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  /*
   * Cố ý dùng `flex: none` thay cho thuộc tính co giãn viết tách rời.
   * Tailwind quét NGUYÊN file này — kể cả comment — và coi mọi chuỗi gạch nối
   * trông giống tên class là class thật, rồi sinh utility đó vào sheet dùng
   * chung. Một lần lỡ tay như vậy đã đo được là +27 byte trên cả 20 trang, cho
   * một utility không trang nào dùng. Nên trong file này đừng viết ra dạng
   * gạch nối của các thuộc tính trùng tên utility.
   */
  :global(.ask-status svg) {
    width: 0.9375rem;
    height: 0.9375rem;
    flex: none;
    color: var(--color-text-muted);
  }

  :global(.ask-shimmer) {
    background: linear-gradient(
      90deg,
      var(--color-text-muted) 0%,
      var(--color-text-muted) 35%,
      var(--color-text-dark) 50%,
      var(--color-text-muted) 65%,
      var(--color-text-muted) 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    animation: ask-shimmer 1.9s linear infinite;
  }

  @keyframes ask-shimmer {
    to {
      background-position: 200% center;
    }
  }

  /*
   * Khối này BẮT BUỘC nằm sau rule mặc định ở trên. Media query không cộng độ
   * ưu tiên, nên nếu đặt trước thì rule mặc định thắng và người tắt hiệu ứng
   * vẫn lãnh đủ animation — đã đo trên bản build rồi mới chuyển xuống đây.
   */
  @media (prefers-reduced-motion: reduce) {
    :global(.ask-shimmer) {
      animation: none;
      background: none;
      color: var(--color-text-muted);
      -webkit-text-fill-color: currentColor;
    }
  }

  :global(.ask-answer p) {
    margin-bottom: 0.5rem;
  }
  :global(.ask-answer p:last-child) {
    margin-bottom: 0;
  }
  :global(.ask-answer p.ask-h) {
    font-weight: 600;
    margin-top: 0.5rem;
  }
  :global(.ask-answer ul),
  :global(.ask-answer ol) {
    margin: 0.25rem 0 0.5rem;
    padding-left: 1.1rem;
  }
  :global(.ask-answer ul) {
    list-style: disc;
  }
  :global(.ask-answer ol) {
    list-style: decimal;
  }
  :global(.ask-answer li) {
    margin-bottom: 0.15rem;
  }
  :global(.ask-answer strong) {
    font-weight: 600;
  }
  :global(.ask-answer a) {
    color: var(--color-deep-blue-navy);
    text-decoration: underline;
    text-underline-offset: 2px;
    /* URL nguồn hay rất dài, để nó tự xuống dòng thay vì đội rộng cả bảng. */
    overflow-wrap: anywhere;
  }
  :global(.ask-answer a:hover) {
    color: var(--color-professional-blue);
  }
  :global(.ask-answer code) {
    background: var(--color-surface-subtle);
    padding: 0 0.25rem;
    border-radius: 0.25rem;
    font-size: 0.85em;
  }
</style>

<script>
  import { renderMarkdown } from "../scripts/ask-markdown";
  import { fingerprint, readQuota, saveQuota } from "../scripts/ask-web-quota";

  function currentSlug(): string | null {
    const m = location.pathname.match(/^\/(?:bai-viet|vu-an-tieu-bieu)\/([^/]+)\/?$/);
    return m ? m[1] : null;
  }

  const box = document.querySelector<HTMLElement>("[data-ask-box]");
  const form = document.querySelector<HTMLFormElement>("[data-ask-form]");
  const input = document.querySelector<HTMLInputElement>("[data-ask-input]");
  const hint = document.querySelector<HTMLElement>("[data-ask-hint]");

  const panel = document.querySelector<HTMLElement>("[data-ask-panel]");
  const panelForm = document.querySelector<HTMLFormElement>("[data-ask-panel-form]");
  const panelInput = document.querySelector<HTMLInputElement>("[data-ask-panel-input]");
  const submit = document.querySelector<HTMLButtonElement>("[data-ask-submit]");
  const panelSubmit = document.querySelector<HTMLButtonElement>("[data-ask-panel-submit]");
  const messages = document.querySelector<HTMLElement>("[data-ask-messages]");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-ask-close]");
  const welcome = document.querySelector<HTMLElement>("[data-ask-welcome]");
  const panelHint = document.querySelector<HTMLElement>("[data-ask-panel-hint]");
  const limitNotice = document.querySelector<HTMLElement>("[data-ask-limit]");
  const limitText = document.querySelector<HTMLElement>("[data-ask-limit-text]");
  const limitClose = document.querySelector<HTMLButtonElement>("[data-ask-limit-close]");

  if (form && input && submit && panel && panelForm && panelInput && panelSubmit && messages) {
    const isMac = /Mac|iPhone|iPad/.test(navigator.platform);
    if (isMac) {
      if (hint) hint.textContent = "⌘I";
      if (panelHint) panelHint.textContent = "⌘I";
    }

    // Màn rộng cuộn bên trong .site-panel (cửa sổ đứng yên), màn nhỏ cuộn bằng cửa sổ: theo dõi cả hai.
    const scroller = document.querySelector<HTMLElement>(".site-panel");
    const syncBoxOnScroll = () => {
      const offset = Math.max(window.scrollY, scroller?.scrollTop ?? 0);
      box?.toggleAttribute("data-at-top", offset <= 8);
    };
    window.addEventListener("scroll", syncBoxOnScroll, { passive: true });
    scroller?.addEventListener("scroll", syncBoxOnScroll, { passive: true });
    // HTML đã để sẵn data-at-top nên ô nổi không vẽ ra rồi mới trượt đi; chỉ hiện khi trang đã
    // cuộn xuống, kể cả khi trình duyệt khôi phục vị trí cuộn cũ (lúc đó có sự kiện scroll).
    // Trang mở mới, không có #mục, thì còn ở đầu trang nên bỏ lần đọc đầu: đọc scrollY bắt trình duyệt
    // dàn lại cả trang ngay trong script (~30 ms khi font vừa tải xong), Lighthouse tính khoản đó vào LCP.
    const navigation = performance.getEntriesByType("navigation")[0] as PerformanceNavigationTiming | undefined;
    if (location.hash || navigation?.type !== "navigate") syncBoxOnScroll();

    const shell = document.querySelector<HTMLElement>("[data-app-shell]");

    const shellIsScroller = window.matchMedia("(min-width: 640px)");
    let savedScroll = 0;

    const openPanel = () => {

      if (panel.hasAttribute("data-open")) {
        panelInput.focus({ preventScroll: true });
        return;
      }
      savedScroll = window.scrollY;
      panel.classList.remove("translate-x-[calc(100%+1.5rem)]");
      panel.setAttribute("data-open", "");
      panel.setAttribute("aria-hidden", "false");
      panel.removeAttribute("inert");
      document.body.setAttribute("data-ask-panel-open", "");
      if (box) box.setAttribute("data-hidden", "");
      if (shell && shellIsScroller.matches) shell.scrollTop = savedScroll;
      panelInput.focus({ preventScroll: true });
    };

    // refocus = false khi chạm nút X trên màn hình cảm ứng: focus gọi trong cử chỉ chạm sẽ bật bàn
    // phím ảo (iOS còn phóng to trang) đúng lúc người đọc chỉ muốn quay lại bài.
    const closePanel = (refocus = true) => {

      const target =
        shell && shellIsScroller.matches ? shell.scrollTop : savedScroll;
      panel.classList.add("translate-x-[calc(100%+1.5rem)]");
      panel.removeAttribute("data-open");
      panel.setAttribute("aria-hidden", "true");
      panel.setAttribute("inert", "");
      document.body.removeAttribute("data-ask-panel-open");
      if (box) box.removeAttribute("data-hidden");
      window.scrollTo({ top: target, left: 0, behavior: "instant" as ScrollBehavior });
      // Sự kiện scroll tới muộn hơn một nhịp; cập nhật ngay để ô nổi đã hiện khi nhận focus.
      syncBoxOnScroll();
      if (refocus) input.focus({ preventScroll: true });
      else (document.activeElement as HTMLElement | null)?.blur();
    };

    const addUserMessage = (text: string) => {
      const row = document.createElement("div");
      row.className = "flex justify-end";
      const bubble = document.createElement("div");
      bubble.className =
        "max-w-[85%] rounded-2xl bg-surface-subtle px-3 py-1.5 text-[0.875rem] leading-[1.6] text-text-dark";
      bubble.textContent = text;
      row.appendChild(bubble);
      messages.appendChild(row);
    };


    const addAssistantMessage = () => {
      const answer = document.createElement("div");
      answer.className = "ask-answer text-[0.875rem] leading-[1.7] text-text-dark";
      messages.appendChild(answer);
      return answer;
    };

    const ICON_GLOBE =
      '<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"/><path d="M3.6 9h16.8M3.6 15h16.8"/><path d="M11.5 3a17 17 0 0 0 0 18M12.5 3a17 17 0 0 1 0 18"/>';

    // Nhãn luôn gán bằng textContent, innerHTML chỉ dựng khung tĩnh của mình.
    const showStatus = (el: HTMLElement, label: string, icon?: string) => {
      el.innerHTML =
        '<span class="ask-status">' +
        (icon
          ? `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icon}</svg>`
          : "") +
        '<span class="ask-shimmer"></span></span>';
      const text = el.querySelector<HTMLElement>(".ask-shimmer");
      if (text) text.textContent = label;
    };

    const ICON_COPY =
      '<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 9.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667l0 -8.666"/><path d="M4.012 16.737a2.005 2.005 0 0 1 -1.012 -1.737v-10c0 -1.1 .9 -2 2 -2h10c.75 0 1.158 .385 1.5 1"/>';
    const ICON_DONE =
      '<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 12l5 5l9 -9"/>';

    const addCopyButton = (afterEl: HTMLElement, getText: () => string) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "ask-copy";
      btn.setAttribute("aria-label", "Sao chép câu trả lời");
      btn.title = "Sao chép câu trả lời";
      btn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON_COPY}</svg>`;

      let timer = 0;
      btn.addEventListener("click", async () => {
        const text = getText();
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          return;
        }
        const svg = btn.firstElementChild!;
        svg.innerHTML = ICON_DONE;
        btn.setAttribute("data-copied", "");
        btn.title = "Đã sao chép";
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          svg.innerHTML = ICON_COPY;
          btn.removeAttribute("data-copied");
          btn.title = "Sao chép câu trả lời";
        }, 1600);
      });

      afterEl.insertAdjacentElement("afterend", btn);
    };

    const MAX_HISTORY = 6;
    const history: { role: "user" | "assistant"; content: string }[] = [];

    // Hạn mức tìm kiếm trên mạng. Máy chủ mới là bên đếm thật; ở đây chỉ giữ
    // bản sao để hiện thông báo và để gửi kèm câu hỏi sau.
    let quota = readQuota();

    const syncLimitNotice = () => {
      if (!limitNotice || !limitText) return;
      const show = quota.used >= quota.limit && !quota.dismissed;
      if (!show) {
        limitNotice.hidden = true;
        limitText.textContent = "";
        return;
      }
      if (!limitNotice.hidden) return;
      // Hiện khung (còn rỗng) trước, ghi chữ sau một nhịp: vùng role=status đổi chữ lúc còn ẩn,
      // hay hiện ra với chữ có sẵn, thì trình đọc màn hình thường bỏ qua.
      limitNotice.hidden = false;
      window.setTimeout(() => {
        if (limitNotice.hidden) return;
        limitText.textContent =
          `Bạn đã dùng hết ${quota.limit} lượt tìm kiếm trên mạng. ` +
          "Trợ lý vẫn trả lời dựa trên nội dung trên trang.";
      }, 150);
    };

    limitClose?.addEventListener("click", () => {
      quota = { ...quota, dismissed: true };
      saveQuota(quota);
      syncLimitNotice();
    });

    syncLimitNotice();

    let inFlight: AbortController | null = null;
    const scrollToEnd = () => {
      messages.scrollTop = messages.scrollHeight;
    };

    const askQuestion = async (question: string) => {

      welcome?.remove();
      inFlight?.abort();
      const controller = new AbortController();
      inFlight = controller;

      openPanel();
      addUserMessage(question);
      const answer = addAssistantMessage();

      // Tắt đọc trong lúc chữ đang chạy, để trình đọc màn hình khỏi đọc từng mẩu. Chữ cuối cùng,
      // kể cả thông báo lỗi, phải bật lại vùng thông báo TRƯỚC khi ghi thì mới được đọc lên.
      answer.setAttribute("aria-live", "off");
      const showFinal = (text: string) => {
        answer.setAttribute("aria-live", "polite");
        answer.textContent = text;
      };
      scrollToEnd();

      showStatus(answer, "Đang suy nghĩ");
      let thinkingStopped = false;
      const stopThinking = () => {
        if (thinkingStopped) return;
        thinkingStopped = true;
        answer.textContent = "";
      };

      let raw = "";
      let finalShown = false;

      let frame = 0;
      const flush = () => {
        frame = 0;
        answer.innerHTML = renderMarkdown(raw);
        scrollToEnd();
      };
      const scheduleRender = () => {
        if (!frame) frame = requestAnimationFrame(flush);
      };

      try {
        const res = await fetch("/api/v1/chat", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          signal: controller.signal,
          body: JSON.stringify({
            message: question,
            slug: currentSlug(),
            history: history.slice(-MAX_HISTORY),
            fp: fingerprint(),
            used: quota.used,
          }),
        });
        if (!res.ok || !res.body) {
          // Máy chủ trả lý do cụ thể ("Câu hỏi quá dài."…); hiện đúng câu đó thay
          // vì "đang bận" để người đọc khỏi bấm gửi lại vô ích.
          const detail = await res
            .json()
            .then((j: { error?: unknown }) => (typeof j?.error === "string" ? j.error : ""))
            .catch(() => "");
          stopThinking();
          showFinal(detail || "Hệ thống đang bận, thử lại sau nhé.");
          return;
        }
        const reader = res.body.getReader();
        const dec = new TextDecoder();
        let buf = "";
        for (;;) {
          const { value, done } = await reader.read();
          if (done) break;
          buf += dec.decode(value, { stream: true });
          let nl;
          while ((nl = buf.indexOf("\n")) >= 0) {
            const line = buf.slice(0, nl).trimEnd();
            buf = buf.slice(nl + 1);
            if (!line.startsWith("data:")) continue;
            let obj: {
              t?: string;
              r?: number;
              m?: number;
              e?: string;
              w?: string;
              s?: number;
              n?: number;
              x?: number;
            };
            try {
              obj = JSON.parse(line.slice(5).replace(/^ /, ""));
            } catch {
              continue;
            }
            stopThinking();
            if (typeof obj.t === "string") {
              raw += obj.t;
              scheduleRender();
            } else if (typeof obj.r === "number") {
              showStatus(answer, `Đang thử lại (${obj.r}/${obj.m ?? 5})`);
              scrollToEnd();
            } else if (obj.x === 1) {
              // Model lỡ nói "Tôi sẽ tìm kiếm…" rồi mới quyết định tra mạng.
              // Bỏ câu đó đi, câu trả lời thật sẽ tới sau khi có kết quả.
              raw = "";
              if (frame) {
                cancelAnimationFrame(frame);
                frame = 0;
              }
              answer.textContent = "";
            } else if (typeof obj.w === "string") {
              // Tavily mất vài giây; đừng để người đọc nhìn bong bóng rỗng.
              showStatus(answer, "Đang tìm kiếm thông tin trên mạng", ICON_GLOBE);
              scrollToEnd();
            } else if (typeof obj.s === "number") {
              quota = {
                used: obj.s,
                limit: typeof obj.n === "number" && obj.n > 0 ? obj.n : quota.limit,
                dismissed: quota.dismissed,
              };
              saveQuota(quota);
              syncLimitNotice();
            } else if (typeof obj.e === "string") {
              if (frame) {
                cancelAnimationFrame(frame);
                frame = 0;
              }
              showFinal(obj.e);
              finalShown = true;
              scrollToEnd();
            }
          }
        }
        stopThinking();
        if (frame) cancelAnimationFrame(frame);
        // Lỗi giữa chừng: giữ nguyên thông báo lỗi, không đè bằng câu trả lời dở
        // và không nhét câu dở đó vào lịch sử hội thoại.
        if (raw && !finalShown) {
          answer.setAttribute("aria-live", "polite");
          flush();
          const copied = raw;
          addCopyButton(answer, () => copied);
          history.push({ role: "user", content: question });
          history.push({ role: "assistant", content: raw });
          while (history.length > MAX_HISTORY) history.shift();
        } else if (!finalShown) {
          showFinal("Hệ thống đang bận, thử lại sau nhé.");
        }
      } catch (err) {
        if (frame) cancelAnimationFrame(frame);
        stopThinking();
        if ((err as Error)?.name === "AbortError") {

          if (raw) flush();
          else answer.remove();
          return;
        }
        showFinal("Không kết nối được máy chủ, thử lại sau nhé.");
      } finally {
        if (inFlight === controller) inFlight = null;
      }
    };

    const syncButton = (el: HTMLInputElement, btn: HTMLButtonElement, owner: HTMLElement) => {
      const empty = el.value.trim().length === 0;
      owner.toggleAttribute("data-has-text", !empty);
      btn.disabled = empty;
    };

    // Nút gửi trong trợ lý chỉ hiện khi đã có chữ (dấu cách không tính).
    const syncBox = () => syncButton(input, submit, form);
    const syncPanel = () => {
      syncButton(panelInput, panelSubmit, panelForm);
      panelSubmit.classList.toggle("invisible", panelInput.value.trim().length === 0);
    };

    input.addEventListener("input", syncBox);
    panelInput.addEventListener("input", syncPanel);
    syncBox();
    syncPanel();

    document.querySelectorAll<HTMLButtonElement>("[data-ask-suggest]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const question = btn.dataset.askQuestion;
        if (question) askQuestion(question);
      });
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const question = input.value.trim();
      if (!question) return;
      input.value = "";
      syncBox();
      askQuestion(question);
    });

    panelForm.addEventListener("submit", (event) => {
      event.preventDefault();
      const question = panelInput.value.trim();
      if (!question) return;
      panelInput.value = "";
      syncPanel();
      askQuestion(question);
    });

    // Chạm nút X bằng tay thì không trả focus về ô nổi. Bấm bằng chuột, hoặc bằng bàn phím
    // (detail 0: Enter/Space), thì trả như khi bấm Esc. Trình duyệt chưa cho biết pointerType
    // của cú bấm thì đoán theo loại con trỏ chính của máy.
    const finePointer = window.matchMedia("(pointer: fine)");
    closeBtn?.addEventListener("click", (event) => {
      const kind = (event as PointerEvent).pointerType;
      const byTouch = event.detail !== 0 && (kind ? kind !== "mouse" : !finePointer.matches);
      closePanel(!byTouch);
    });

    // Phải khớp đúng media query ẩn trợ lý trong khối <style> bên trên.
    const TABLET_PORTRAIT = "(orientation: portrait) and (min-width: 600px) and (pointer: coarse)";
    const tabletPortrait = window.matchMedia(TABLET_PORTRAIT);

    // Xoay máy tính bảng sang dọc trong lúc bảng đang mở: CSS ẩn bảng đi nhưng
    // body vẫn còn data-ask-panel-open, kéo theo overflow:hidden và khung nội dung
    // bị ghim position:fixed — trang kẹt cứng, không cuộn nổi mà cũng không còn
    // nút đóng để thoát. Đóng bảng ngay khi bước vào trạng thái bị ẩn.
    const closeIfHidden = (matches: boolean) => {
      if (matches && panel.hasAttribute("data-open")) closePanel();
    };
    closeIfHidden(tabletPortrait.matches);
    tabletPortrait.addEventListener("change", (e) => closeIfHidden(e.matches));

    document.addEventListener("keydown", (event) => {
      // Máy tính bảng dựng đứng (có bàn phím rời): CSS đang ẩn trợ lý, mở bảng lúc này chỉ ghim
      // trang cạnh một khoảng trống. Để nguyên phím tắt cho trình duyệt.
      if (tabletPortrait.matches) return;
      if (event.defaultPrevented) return;
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "i") {
        event.preventDefault();
        panel.hasAttribute("data-open") ? closePanel() : openPanel();
      } else if (event.key === "Escape") {
        if (panel.hasAttribute("data-open")) closePanel();
        else if (document.activeElement === input) input.blur();
      }
    });
  }
</script>
