---
import { navigationItems, type NavigationItem } from "../data/navigation";

const currentPath = Astro.url.pathname;
const matchesPrefix = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);

const isActive = (item: NavigationItem) =>
  [item.href, ...(item.activePrefixes ?? [])].some(matchesPrefix);

// Nhãn nút menu di động: tên mục đang xem, trang chủ là "Trang chủ", trang lạ thì "Menu".
const menuLabel = currentPath === "/" ? "Trang chủ" : (navigationItems.find(isActive)?.label ?? "Menu");

// Khung bọc ngăn kéo di động có style overflow:clip (lớp ẩn phần tràn để dự phòng cho trình
// duyệt cũ) nên không còn là vùng cuộn: focus hay địa chỉ /#mobile-menu không thể cuộn ngăn kéo
// đang đóng ra che trang. Ngăn kéo đóng thì inert (navigation.ts bật tắt).

---

<header
  class="sticky top-0 z-50 bg-surface-white px-[var(--frame-gap)]"
>
  <div class="flex h-[var(--header-h)] items-center gap-8">

    <a href="/" class="shrink-0" aria-label="CNN Legal trang chủ">
      <span class="font-sans text-[1.5rem] font-bold tracking-tight text-text-dark">
        CNN Legal
      </span>
    </a>

    <nav
      class="hidden items-center gap-1 lg:flex"
      aria-label="Điều hướng chính"
    >
      {navigationItems.map((item) => (
        <a
          class:list={[
            "px-3 py-2 text-[1rem] font-medium leading-none transition-colors",
            isActive(item) ? "text-text-dark" : "text-text-muted hover:text-text-dark",
          ]}
          href={item.href}
          aria-current={isActive(item) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-4">
      <a
        href="/lien-he/"
        class="hidden h-10 items-center rounded-full bg-[#0066cc] px-5 text-[0.9375rem] font-medium text-white transition-colors hover:bg-[#004080] active:scale-[0.97] lg:inline-flex"
      >
        Liên hệ
      </a>
      <button
        class="inline-flex h-8 items-center gap-1.5 rounded-full border border-ink-black/60 bg-surface-white px-3 text-[0.875rem] font-medium text-text-dark transition-colors hover:bg-surface-subtle lg:hidden"
        type="button"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Mở menu"
        data-menu-button
      >
        <span>{menuLabel}</span>
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M5.5 8.5h13a1 1 0 0 1 .8 1.6l-6.5 7.4a1 1 0 0 1-1.6 0L4.7 10.1a1 1 0 0 1 .8-1.6z" />
        </svg>
      </button>
    </div>

  </div>

  <div class="pointer-events-none fixed inset-x-0 top-0 z-50 h-dvh overflow-hidden lg:hidden" style="overflow:clip">
  <aside
    id="mobile-menu"
    class="pointer-events-auto absolute inset-0 h-full w-full translate-x-full overflow-y-auto bg-surface-white px-5 py-5 transition-transform duration-200 ease-[cubic-bezier(0.16,1,0.3,1)]"
    aria-label="Menu"
    data-mobile-drawer
    inert
  >
    <div class="mb-2 flex items-center justify-between">
      <a href="/" class="shrink-0" aria-label="CNN Legal trang chủ">
        <span class="font-sans text-[1.25rem] font-bold tracking-tight text-text-dark">
          CNN Legal
        </span>
      </a>
      <button
        class="inline-flex h-8 w-8 items-center justify-center rounded text-text-muted hover:bg-surface-subtle"
        type="button"
        aria-label="Đóng menu"
        data-menu-close
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6l-12 12" />
          <path d="M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav class="mt-1" aria-label="Điều hướng chính">
      {navigationItems.map((item) => (
        <a
          class:list={["-mx-3 flex items-center justify-between rounded-xl px-3 py-2.5 text-[0.875rem] font-medium text-text-muted transition-colors hover:bg-[#e6e6e6] focus-visible:bg-[#e6e6e6]", isActive(item) && "font-semibold"]}
          href={item.href}
          aria-current={isActive(item) ? "page" : undefined}
        >
          {item.label}
          <svg class="h-4 w-4 shrink-0 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
        </a>
      ))}
      <a class="-mx-3 flex items-center justify-between rounded-xl px-3 py-2.5 text-[0.875rem] font-medium text-text-muted transition-colors hover:bg-[#e6e6e6] focus-visible:bg-[#e6e6e6]" href="/lien-he/">
        Liên hệ
        <svg class="h-4 w-4 shrink-0 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
      </a>
    </nav>
  </aside>
  </div>
</header>

<script src="../scripts/navigation.ts"></script>
