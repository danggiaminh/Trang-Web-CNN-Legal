---
import { navigationItems, type NavigationItem } from "../data/navigation";
import Search from "./Search.astro";

const currentPath = Astro.url.pathname;
const matchesPrefix = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);

const isActive = (item: NavigationItem) =>
  [item.href, ...(item.activePrefixes ?? [])].some(matchesPrefix);

---

<header
  class="sticky top-0 z-50 -mb-[var(--nav-h)]"
>
  <div class="section-shell grid h-[var(--nav-h)] grid-cols-[1fr_auto_1fr] items-center gap-6">

    <a
      href="/"
      class="glass-pill col-start-1 shrink-0 justify-self-start px-4 py-2"
      aria-label="CNN Legal trang chủ"
    >
      <span class="font-sans text-[1.5rem] font-bold tracking-tight text-white">
        CNN Legal
      </span>
    </a>

    <nav
      class="glass-pill col-start-2 hidden items-center gap-0.5 p-1 lg:flex"
      aria-label="Điều hướng chính"
      data-primary-nav
    >
      {navigationItems.map((item) => (
        <a
          class:list={[
            "rounded-full px-3.5 py-1.5 text-[0.9375rem] leading-none transition-all",
            isActive(item)
              ? "bg-white/20 font-semibold text-white"
              : "font-medium text-white/75 hover:bg-white/10 hover:text-white",
          ]}
          href={item.href}
          aria-current={isActive(item) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="col-start-3 flex shrink-0 items-center justify-self-end gap-3">
      <Search />
      <a
        href="/lien-he/"
        class="glass-pill glass-pill-strong hidden px-5 py-2 text-[0.9375rem] font-medium text-white transition-all active:scale-[0.97] lg:inline-flex"
      >
        Liên hệ
      </a>
      <button
        class="glass-pill inline-flex h-9 w-9 items-center justify-center text-white lg:hidden"
        type="button"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Mở menu"
        data-menu-button
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 6l16 0" />
          <path d="M4 12l16 0" />
          <path d="M4 18l16 0" />
        </svg>
      </button>
    </div>

  </div>

  <div class="pointer-events-none fixed inset-x-0 top-0 z-50 h-dvh overflow-hidden lg:hidden">
  <aside
    id="mobile-menu"
    class="pointer-events-auto absolute inset-0 h-full w-full translate-x-full overflow-y-auto bg-surface-white px-5 py-5 transition-transform duration-200 ease-[cubic-bezier(0.16,1,0.3,1)]"
    aria-label="Điều hướng di động"
    data-mobile-drawer
  >
    <div class="mb-6 flex items-center justify-between">
      <a href="/" class="shrink-0" aria-label="CNN Legal trang chủ">
        <span class="font-sans text-[1.25rem] font-bold tracking-tight text-text-dark">
          CNN Legal
        </span>
      </a>
      <button
        class="inline-flex h-8 w-8 items-center justify-center rounded text-text-muted hover:bg-surface-subtle"
        type="button"
        aria-label="Đóng menu"
        data-menu-close
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6l-12 12" />
          <path d="M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav class="flex flex-col gap-0.5" aria-label="Điều hướng di động">
      {navigationItems.map((item) => (
        <a
          class:list={[
            "rounded px-3 py-2.5 text-[0.9375rem] font-medium hover:text-text-dark",
            isActive(item) ? "text-text-dark" : "text-text-muted",
          ]}
          href={item.href}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="mt-6 border-t border-border-soft pt-5">
      <a
        href="/lien-he/"
        class="flex items-center justify-center rounded-full bg-ink-black py-2.5 text-[0.9375rem] font-medium text-white transition-all duration-150 ease-[cubic-bezier(0.16,1,0.3,1)] hover:bg-ink-hover active:scale-[0.97]"
      >
        Liên hệ
      </a>
    </div>
  </aside>
  </div>
</header>

<style>
  @media (min-width: 1280px) {
    header :global(.section-shell) {
      font-size: 16px;
      width: min(100% - 2em, 73em);
      height: 3.75em;
      gap: 1.5em;
    }

    header :global([data-search-overlay]) {
      font-size: 1rem;
    }

    header :global(a[aria-label="CNN Legal trang chủ"] span) {
      font-size: 1.5em;
    }

    header :global([data-primary-nav]) {
      gap: 0.125em;
      padding: 0.25em;
    }

    header :global([data-primary-nav] a) {
      font-size: 0.9375em;
      padding: 0.375em 0.875em;
    }

    header :global(.col-start-3) {
      gap: 0.75em;
    }

    header :global(a[href="/lien-he/"]) {
      font-size: 0.9375em;
      padding: 0.5em 1.25em;
    }

    header :global([data-search-open]) {
      height: 2.5em;
      width: 2.5em;
    }

    header :global([data-search-open] svg) {
      height: 1.375em;
      width: 1.375em;
    }
  }
</style>

<script src="../scripts/navigation.ts"></script>
