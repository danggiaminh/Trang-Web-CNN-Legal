---
import { Picture } from "astro:assets";
import HeroBreadcrumb from "./HeroBreadcrumb.astro";
import { services } from "../data/services";
import servicesHero from "../assets/images/services-nhatrang.jpg";

interface Crumb {
  readonly label: string;
  readonly href?: string;
}

interface Props {
  readonly crumbs: readonly Crumb[];
  /** Slug của dịch vụ đang xem, để đánh dấu mục tương ứng ở cột trái. */
  readonly currentSlug?: string;
  /** Trang tổng quan dùng tiêu đề hero làm h1; trang chi tiết để h1 cho tên dịch vụ. */
  readonly titleIsH1?: boolean;
}

const { crumbs, currentSlug, titleIsH1 = false } = Astro.props;
const TitleTag = titleIsH1 ? "h1" : "p";
---

<section class="relative overflow-hidden py-20 md:py-28 lg:py-32">
  <div class="absolute inset-0 z-0" style="background-color:#75a2d2">
    {/* Ảnh 3:2; banner màn hẹp cao 254px nên dưới 381px ảnh phóng theo chiều cao.
        Banner desktop chỉ lộ ~29% chiều cao ảnh: căn giữa thì cắt ngang dãy nhà
        (61–67% chiều cao), nên dời tiêu điểm xuống 63%.
        quality 65: giống ảnh gốc ngang WebP 80 (SSIM 0,981; dải thành phố 0,965 so với
        0,966). 70 nét hơn chút nhưng bản 768w nặng 48 KB, đủ làm FCP mô phỏng của
        Lighthouse mobile lệch sang 99 điểm ở 2/8 lượt; ở 65 còn ~39 KB. */}
    <Picture
      class="h-full w-full object-cover"
      style="object-position:50% 63%"
      src={servicesHero}
      alt="Thành phố biển nhìn từ vịnh"
      formats={["avif"]}
      fallbackFormat="webp"
      widths={[640, 768, 960, 1280, 1600, 1920, 2560, 3840]}
      sizes="(max-width: 380px) 381px, 100vw"
      quality={65}
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="section-shell relative z-10">
    <HeroBreadcrumb items={[...crumbs]} />
    <TitleTag class="mt-8 text-balance max-w-4xl font-sans text-[2.25rem] font-semibold leading-[1.14] tracking-[-0.01em] text-white md:text-[2.75rem] lg:text-[3.125rem]">
      Dịch vụ pháp lý
    </TitleTag>
  </div>
</section>

<section>
  <div class="section-shell svc-grid">
    {/* Nội dung đứng trước trong DOM: trên điện thoại hiện trước danh mục, trình đọc
        màn hình cũng đọc nội dung trước. Lưới desktop đưa danh mục sang cột trái. */}
    <div class="svc-content">
      <slot />
    </div>

    <aside class="svc-aside" aria-labelledby="svc-aside-title">
      <h2 id="svc-aside-title" class="svc-aside-title">
        <a href="/dich-vu/" aria-current={currentSlug ? undefined : "page"}>Dịch vụ</a>
      </h2>
      <ul class="svc-list">
        {services.map((s) => (
          <li>
            <a href={`/dich-vu/${s.slug}/`} aria-current={s.slug === currentSlug ? "page" : undefined}>
              {s.title}
            </a>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</section>

<style>
  /* Hero giống các trang khác của site, bên dưới là danh mục dịch vụ bên trái và
     nội dung bên phải, cùng một nền trắng. CSS để scoped ở đây nên chỉ nằm trong 5
     trang dịch vụ, không thêm byte cho trang khác. */

  /* Nền trắng tới tận cuối trang: khoảng trống dưới phần nội dung vốn lấy màu kem
     chung của site, lộ ra thành một dải khác màu. */
  :global(body) {
    background: var(--color-surface-white);
  }

  .svc-grid {
    display: grid;
  }

  .svc-content {
    min-width: 0;
    padding-block: 2.5rem 3.5rem;
  }

  .svc-aside {
    padding-block: 2.5rem 3rem;
  }

  .svc-aside-title {
    margin: 0 0 1rem;
    padding-inline: 1rem;
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text-dark);
  }

  .svc-list {
    border-top: 1px solid var(--color-panel-taupe-border);
  }

  .svc-list li {
    border-bottom: 1px solid var(--color-panel-taupe-border);
  }

  .svc-list a {
    display: block;
    padding: 0.625rem 1rem;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-text-dark);
    transition: color 150ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .svc-list a:hover {
    color: var(--color-deep-blue-navy);
  }

  .svc-list a[aria-current="page"] {
    color: var(--color-deep-blue-navy);
    font-weight: 600;
  }

  /* Kiểu chữ chung cho nội dung do từng trang đưa vào slot. */
  .svc-content :global(h1) {
    margin: 0 0 1.25rem;
    font-size: 1.625rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-text-dark);
  }

  .svc-content :global(p) {
    margin: 0 0 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--color-text-dark);
  }

  /* Nhãn in đậm + danh sách trơn: "Phạm vi dịch vụ" ở trang chi tiết và
     "Dịch vụ hỗ trợ" ở trang tổng quan. */
  .svc-content :global(.svc-label) {
    margin: 2rem 0 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--color-text-dark);
  }

  .svc-content :global(.svc-plain-list li) {
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--color-text-dark);
  }

  .svc-content :global(.svc-plain-list a) {
    text-underline-offset: 2px;
    transition: color 150ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .svc-content :global(.svc-plain-list a:hover) {
    color: var(--color-deep-blue-navy);
    text-decoration: underline;
  }

  @media (min-width: 1024px) {
    .svc-grid {
      grid-template-columns: 23rem minmax(0, 1fr);
      column-gap: 6rem;
      align-items: start;
    }

    .svc-content {
      grid-column: 2;
      grid-row: 1;
      padding-block: 5.5rem 6rem;
    }

    .svc-aside {
      grid-column: 1;
      grid-row: 1;
      padding-block: 5.5rem 6.5rem;
    }
  }
</style>
