# Biến môi trường cho trang web (Astro). Backend Rust dùng file riêng ở
# rag-backend/.env — hai bên độc lập, sửa bên này không ảnh hưởng bên kia.
#
# Chạy máy: chép file này thành .env ở thư mục gốc rồi điền khoá.
# Trên Vercel: Project Settings → Environment Variables, thêm từng biến, chọn cả
# ba môi trường Production / Preview / Development. KHÔNG upload file .env.
#
# Chỉ OPENROUTER_API_KEY là bắt buộc. Các biến còn lại đã có mặc định trong
# astro.config.mjs, để trống cũng chạy.

# Bắt buộc. Đọc lúc chạy, không bị nhúng vào file build.
OPENROUTER_API_KEY=

# Tuỳ chọn — đổi giá trị thì phải deploy lại vì chúng được nhúng vào bundle máy chủ.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Ghim nhà cung cấp để giá mỗi token không đổi sau lưng. Để trống thì OpenRouter tự chọn.
OPENROUTER_PROVIDER=parasail
OPENROUTER_MAX_TOKENS=1200
OPENROUTER_REFERER=https://cnnlegal.vn
OPENROUTER_TITLE=CNN Legal Assistant

# Origin được phép gọi /api/v1/chat từ trình duyệt, phân cách bằng dấu phẩy.
CHAT_ALLOWED_ORIGINS=https://cnnlegal.vn,https://www.cnnlegal.vn,http://localhost:4321
